#!/bin/sh
{{#if (ne elixirClustering "none")}}
if [ -z "${RELEASE_COOKIE:-}" ]; then
  printf '%s\n' 'Set RELEASE_COOKIE to the same private value on every cluster node.' >&2
  exit 1
fi

export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
{{#if (eq elixirDeploy "fly")}}
if [ -n "${FLY_PRIVATE_IP:-}" ]; then
  export RELEASE_NODE="${RELEASE_NODE:-{{elixirAppName}}@${FLY_PRIVATE_IP}}"
  export ERL_AFLAGS="${ERL_AFLAGS:-} -proto_dist inet6_tcp"
else
  export RELEASE_NODE="${RELEASE_NODE:-{{elixirAppName}}@127.0.0.1}"
fi
{{else}}
export RELEASE_NODE="${RELEASE_NODE:-{{elixirAppName}}@127.0.0.1}"
{{/if}}
{{/if}}
