{{#if (ne elixirMessageQueue "none")}}
ExUnit.start(exclude: [:message_queue])
{{else}}
ExUnit.start()
{{/if}}
{{#if (eq elixirJobs "exq")}}
{:ok, _} = Exq.Mock.start_link(mode: :fake)
{{/if}}
{{#if (eq elixirTesting "wallaby")}}
{:ok, _} = Application.ensure_all_started(:wallaby)

Application.put_env(
  :wallaby,
  :base_url,
  {{elixirModuleName}}Web.Endpoint.url()
)
{{/if}}
{{#if (or (eq elixirOrm "ecto-sql") (or (eq elixirOrm "myxql") (eq elixirOrm "ecto_sqlite3")))}}

Ecto.Adapters.SQL.Sandbox.mode(
  {{elixirModuleName}}.Repo,
  :manual
)
{{/if}}
