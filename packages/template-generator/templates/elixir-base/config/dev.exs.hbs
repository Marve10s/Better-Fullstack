import Config
{{#if (ne elixirWebFramework "none")}}

config :{{elixirAppName}}, {{elixirModuleName}}Web.Endpoint,
  http: [ip: {127, 0, 0, 1}, port: String.to_integer(System.get_env("PORT") || "4000")],
  check_origin: false,
  code_reloader: true,
  debug_errors: true,
  secret_key_base: "dev-only-secret-key-base-placeholder-do-not-use-in-production-000000",
  watchers: []

config :{{elixirAppName}}, dev_routes: true
{{/if}}
{{#if (eq elixirAuth "guardian")}}

config :{{elixirAppName}}, {{elixirModuleName}}.Auth.Guardian,
  secret_key: "dev-only-guardian-secret-placeholder-do-not-use-in-production-0000000"
{{/if}}
{{#if (eq elixirOrm "ecto-sql")}}

config :{{elixirAppName}}, {{elixirModuleName}}.Repo,
  username: System.get_env("POSTGRES_USER", "postgres"),
  password: System.get_env("POSTGRES_PASSWORD", "postgres"),
  hostname: System.get_env("POSTGRES_HOST", "localhost"),
  database: System.get_env("POSTGRES_DB", "{{elixirAppName}}_dev"),
  stacktrace: true,
  show_sensitive_data_on_connection_error: true,
  pool_size: 10
{{/if}}
{{#if (eq elixirOrm "myxql")}}

config :{{elixirAppName}}, {{elixirModuleName}}.Repo,
  username: System.get_env("MYSQL_USER", "root"),
  password: System.get_env("MYSQL_PASSWORD", "mysql"),
  hostname: System.get_env("MYSQL_HOST", "localhost"),
  database: System.get_env("MYSQL_DATABASE", "{{elixirAppName}}_dev"),
  stacktrace: true,
  show_sensitive_data_on_connection_error: true,
  pool_size: 10
{{/if}}
{{#if (eq elixirOrm "ecto_sqlite3")}}

config :{{elixirAppName}}, {{elixirModuleName}}.Repo,
  database: System.get_env("DATABASE_PATH", "{{elixirAppName}}_dev.db"),
  pool_size: 5
{{/if}}

config :logger, :console, format: "[$level] $message\n"
{{#if (ne elixirWebFramework "none")}}
config :phoenix, :stacktrace_depth, 20
config :phoenix, :plug_init_mode, :runtime
{{/if}}
