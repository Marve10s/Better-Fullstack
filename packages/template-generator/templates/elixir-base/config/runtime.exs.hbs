import Config

# Load KEY=VALUE pairs from a local .env in dev so scaffold-time settings
# (e.g. CORS_ORIGIN) apply to `mix phx.server`. Real environment variables win.
if config_env() == :dev and File.exists?(".env") do
  ".env"
  |> File.read!()
  |> String.split("\n")
  |> Enum.each(fn line ->
    line = String.trim(line)

    with false <- line == "" or String.starts_with?(line, "#"),
         [key, value] when value != "" <- String.split(line, "=", parts: 2),
         nil <- System.get_env(key) do
      System.put_env(key, value)
    end
  end)
end
{{#if (eq elixirConfig "dotenvy")}}
import Dotenvy

source!([".env", System.get_env()])

config :{{elixirAppName}}, :settings,
  greeting: env!("APP_GREETING", :string, "Hello"),
  max_connections: env!("APP_MAX_CONNECTIONS", :integer, 10)

{{/if}}
{{#if (eq elixirClustering "libcluster")}}
cluster_hosts =
  System.get_env("CLUSTER_HOSTS", "")
  |> String.split(",", trim: true)
  |> Enum.map(&String.trim/1)
  |> Enum.reject(&(&1 == ""))
  |> Enum.map(&String.to_atom/1)

cluster_dns_query =
  System.get_env("DNS_CLUSTER_QUERY"){{#if (eq elixirDeploy "fly")}} ||
    case System.get_env("FLY_APP_NAME") do
      nil -> nil
      app_name -> "#{app_name}.internal"
    end{{/if}}

cluster_topologies =
  cond do
    cluster_hosts != [] ->
      [configured_hosts: [strategy: Cluster.Strategy.Epmd, config: [hosts: cluster_hosts, timeout: 1_000]]]

    is_binary(cluster_dns_query) and cluster_dns_query != "" ->
      [dns: [strategy: Cluster.Strategy.DNSPoll,
             config: [query: cluster_dns_query, node_basename: "{{elixirAppName}}", polling_interval: 5_000]]]

    true ->
      []
  end

config :{{elixirAppName}}, :cluster_topologies, cluster_topologies

{{/if}}
{{#if (eq elixirClustering "dns-cluster")}}
dns_cluster_query =
  System.get_env("DNS_CLUSTER_QUERY"){{#if (eq elixirDeploy "fly")}} ||
    case System.get_env("FLY_APP_NAME") do
      nil -> nil
      app_name -> "#{app_name}.internal"
    end{{/if}}

config :{{elixirAppName}}, :dns_cluster_query, dns_cluster_query

{{/if}}
{{#if (eq elixirClustering "distributed-erlang")}}
