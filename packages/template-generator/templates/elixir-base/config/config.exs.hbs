import Config
{{#if (eq elixirApplicationFramework "ash")}}

config :{{elixirAppName}},
  ash_domains: [{{elixirModuleName}}.CatalogDomain]

config :ash, default_string_length_count: :codepoints
{{/if}}

{{#if (or (eq elixirOrm "ecto-sql") (or (eq elixirOrm "myxql") (eq elixirOrm "ecto_sqlite3")))}}
config :{{elixirAppName}},
  ecto_repos: [{{elixirModuleName}}.Repo],
  generators: [timestamp_type: :utc_datetime]
{{else}}
config :{{elixirAppName}},
  generators: [timestamp_type: :utc_datetime]
{{/if}}
{{#if (ne elixirWebFramework "none")}}

config :{{elixirAppName}},
       {{elixirModuleName}}Web.Endpoint,
       url: [host: "localhost"],
{{#if (eq elixirHttpServer "bandit")}}
       adapter: Bandit.PhoenixAdapter,
{{/if}}
       render_errors: [
         formats: [
           html: {{elixirModuleName}}Web.ErrorHTML,
           json: {{elixirModuleName}}Web.ErrorJSON
         ],
         layout: false
       ],
       pubsub_server: {{elixirModuleName}}.PubSub,
       live_view: [signing_salt: "change-me"]
{{/if}}

{{#if (eq elixirConfig "confex")}}
config :{{elixirAppName}}, {{elixirModuleName}}.Settings,
  greeting: {:system, "APP_GREETING", "Hello"},
  max_connections: {:system, :integer, "APP_MAX_CONNECTIONS", 10}

{{/if}}
config :logger, :console,
  format: "$time $metadata[$level] $message\n",
  metadata: [:request_id]
{{#if (eq elixirLogging "logger-json")}}

config :logger, :default_handler,
  formatter: {LoggerJSON.Formatters.Basic, metadata: [:request_id]}
{{#if (eq elixirJson "elixir-json")}}

config :logger_json, encoder: JSON
{{/if}}
{{/if}}
{{#if (eq elixirLogging "logger-file-backend")}}

config :logger, :file_log,
  path: "log/{{elixirAppName}}.log",
  level: :info,
  format: "$time $metadata[$level] $message\n",
  metadata: [:request_id]
{{/if}}
{{#if (eq elixirLogging "logster")}}

config :phoenix, :logger, false
{{/if}}

{{#if (eq elixirApi "grpc")}}
config :{{elixirAppName}}, {{elixirModuleName}}.GRPCEndpoint,
  port: 50051,
  start_server: config_env() != :test,
  max_body_size: 32_768,
  adapter_opts: [ip: {127, 0, 0, 1}, idle_timeout: 5_000]

{{/if}}
{{#if (ne elixirWebFramework "none")}}

config :phoenix, :json_library, {{#if (eq elixirJson "elixir-json")}}JSON{{else if (eq elixirJson "jiffy")}}{{elixirModuleName}}.JSON{{else}}Jason{{/if}}
{{/if}}
{{#if (eq elixirJobs "oban")}}

config :{{elixirAppName}},
       Oban,
       repo: {{elixirModuleName}}.Repo,
       queues: [default: 10],
       plugins: [Oban.Plugins.Pruner]
{{/if}}
{{#if (eq elixirJobs "quantum")}}

config :{{elixirAppName}},
       {{elixirModuleName}}.Scheduler,
       jobs: [
         heartbeat: [
           schedule: "@hourly",
           task: fn -> :ok end
         ]
       ]
{{/if}}
{{#if (eq elixirJobs "exq")}}

config :exq,
  name: Exq,
  namespace: "exq",
  queues: ["default"],
  concurrency: :infinite,
  start_on_application: false
{{/if}}
{{#if (eq elixirEmail "swoosh")}}

config :{{elixirAppName}},
       {{elixirModuleName}}.Mailer,
       adapter: Swoosh.Adapters.Local

config :swoosh, api_client: Swoosh.ApiClient.Finch
{{/if}}
{{#if (eq elixirEmail "bamboo")}}

config :{{elixirAppName}},
       {{elixirModuleName}}.Mailer,
       adapter: Bamboo.LocalAdapter
{{/if}}
{{#if (eq elixirCaching "nebulex")}}

config :{{elixirAppName}},
       {{elixirModuleName}}.Cache,
       gc_interval: :timer.hours(12),
       max_size: 100_000
{{/if}}
{{#if (eq elixirObservability "prom_ex")}}

grafana_folder = "{{projectName}} Dashboards"

config :{{elixirAppName}},
       {{elixirModuleName}}.PromEx,
       manual_metrics_start_delay: :no_delay,
       drop_metrics_groups: [],
       grafana: [
         host: System.get_env("GRAFANA_HOST", "http://localhost:3000"),
         auth_token: System.get_env("GRAFANA_TOKEN", ""),
         upload_dashboards_on_start: false,
         folder_name: grafana_folder,
         annotate_app_lifecycle: true
       ]
{{/if}}
{{#if (eq elixirObservability "sentry")}}

config :sentry,
  client: Sentry.HackneyClient,
  environment_name: config_env(),
  enable_source_code_context: true,
  root_source_code_paths: [File.cwd!()]
{{/if}}
{{#if (eq elixirI18n "linguist")}}

config :linguist, pluralization_key: :count
{{/if}}
{{#if (eq elixirClustering "libcluster")}}
config :{{elixirAppName}}, :cluster_topologies, []
{{/if}}
{{#if (eq elixirAuth "pow")}}

config :{{elixirAppName}},
       :pow,
       user: {{elixirModuleName}}.Users.User,
       repo: {{elixirModuleName}}.Repo,
       web_module: {{elixirModuleName}}Web
{{/if}}
{{#if (eq elixirAuth "guardian")}}

config :{{elixirAppName}},
       {{elixirModuleName}}.Auth.Guardian,
       issuer: "{{elixirAppName}}"
{{/if}}
{{#if (eq elixirAuth "ueberauth")}}

config :ueberauth, Ueberauth, providers: []
{{/if}}

import_config "#{config_env()}.exs"
