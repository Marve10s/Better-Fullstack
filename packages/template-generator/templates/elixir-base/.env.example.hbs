{{#if (ne elixirConfig "none")}}
APP_GREETING=Hello
APP_MAX_CONNECTIONS=10
{{/if}}
{{#if (eq elixirMessageQueue "amqp")}}
RABBITMQ_URL=amqp://guest:guest@localhost:5672
{{/if}}
{{#if (eq elixirMessageQueue "gnat")}}
NATS_URL=nats://localhost:4222
{{/if}}
{{#if (eq elixirMessageQueue "brod")}}
KAFKA_BROKERS=localhost:9092
{{/if}}
{{#if (ne elixirClustering "none")}}
RELEASE_COOKIE=
RELEASE_NODE={{elixirAppName}}@127.0.0.1
{{/if}}
{{#if (or (eq elixirClustering "libcluster") (eq elixirClustering "distributed-erlang"))}}
CLUSTER_HOSTS=
{{/if}}
{{#if (or (eq elixirClustering "libcluster") (eq elixirClustering "dns-cluster"))}}
DNS_CLUSTER_QUERY=
{{/if}}
{{#if (eq elixirApi "grpc")}}
GRPC_PORT=50051
{{/if}}
{{#if (ne elixirWebFramework "none")}}
PHX_HOST=localhost
PORT=4000
SECRET_KEY_BASE=replace-with-mix-phx-gen-secret

# Allowed web origin for CORS (unset or empty = allow any origin)
CORS_ORIGIN=
{{/if}}
{{#if (eq elixirOrm "ecto-sql")}}
DATABASE_URL=ecto://postgres:postgres@localhost/{{elixirAppName}}_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_DB={{elixirAppName}}_dev
POSTGRES_TEST_DB={{elixirAppName}}_test
{{/if}}
{{#if (eq elixirOrm "myxql")}}
DATABASE_URL=ecto://root:mysql@localhost/{{elixirAppName}}_prod
MYSQL_USER=root
MYSQL_PASSWORD=mysql
MYSQL_HOST=localhost
MYSQL_DATABASE={{elixirAppName}}_dev
MYSQL_TEST_DATABASE={{elixirAppName}}_test
{{/if}}
{{#if (eq elixirOrm "ecto_sqlite3")}}
DATABASE_PATH={{elixirAppName}}_dev.db
{{/if}}
{{#if (eq elixirAuth "guardian")}}
GUARDIAN_SECRET_KEY=replace-with-mix-guardian-gen-secret
{{/if}}
{{#if (eq elixirObservability "sentry")}}
SENTRY_DSN=
{{/if}}
{{#if (includes elixirLibraries "ex_aws")}}
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
{{/if}}
{{#if (or (eq elixirCaching "redix") (eq elixirJobs "exq"))}}
REDIS_URL=redis://localhost:6379
{{/if}}
