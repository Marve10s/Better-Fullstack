defmodule {{elixirModuleName}}.Application do
  use Application

  @impl true
  def start(_type, _args) do
{{#if (and (eq elixirObservability "opentelemetry") (ne elixirWebFramework "none"))}}
{{#if (eq elixirHttpServer "bandit")}}
    OpentelemetryBandit.setup()
    OpentelemetryPhoenix.setup(adapter: :bandit)
{{else}}
    :opentelemetry_cowboy.setup()
    OpentelemetryPhoenix.setup(adapter: :cowboy2)
{{/if}}

{{/if}}
{{#if (eq elixirCaching "redix")}}
    redis_url = System.get_env("REDIS_URL", "redis://localhost:6379")

{{/if}}
{{#if (eq elixirJobs "oban")}}
    oban_config =
      Application.fetch_env!(
        :{{elixirAppName}},
        Oban
      )

{{/if}}
{{#if (eq elixirClustering "libcluster")}}
    topologies =
      Application.fetch_env!(
        :{{elixirAppName}},
        :cluster_topologies
      )

{{/if}}
{{#if (or (eq elixirObservability "prom_ex") (eq elixirOrm "ecto-sql") (eq elixirOrm "myxql") (eq elixirOrm "ecto_sqlite3") (ne elixirWebFramework "none") (eq elixirHttp "finch") (eq elixirEmail "swoosh") (ne elixirCaching "none") (eq elixirClustering "libcluster") (ne elixirJobs "none"))}}
    children = [
{{#if (eq elixirObservability "prom_ex")}}
      {{elixirModuleName}}.PromEx{{#if (or (eq elixirOrm "ecto-sql") (eq elixirOrm "myxql") (eq elixirOrm "ecto_sqlite3") (ne elixirWebFramework "none") (eq elixirHttp "finch") (eq elixirEmail "swoosh") (ne elixirCaching "none") (eq elixirClustering "libcluster") (ne elixirJobs "none"))}},{{/if}}
{{/if}}
{{#if (or (eq elixirOrm "ecto-sql") (eq elixirOrm "myxql") (eq elixirOrm "ecto_sqlite3"))}}
      {{elixirModuleName}}.Repo{{#if (or (ne elixirWebFramework "none") (eq elixirHttp "finch") (eq elixirEmail "swoosh") (ne elixirCaching "none") (eq elixirClustering "libcluster") (ne elixirJobs "none"))}},{{/if}}
{{/if}}
{{#if (ne elixirWebFramework "none")}}
      {Phoenix.PubSub, name: {{elixirModuleName}}.PubSub},
{{/if}}
{{#if (eq elixirRealtime "presence")}}
      {{elixirModuleName}}Web.Presence,
{{/if}}
{{#if (eq elixirHttp "finch")}}
      {Finch, name: {{elixirModuleName}}.Finch}{{#if (or (ne elixirWebFramework "none") (eq elixirEmail "swoosh") (ne elixirCaching "none") (eq elixirClustering "libcluster") (ne elixirJobs "none"))}},{{/if}}
{{/if}}
{{#if (eq elixirEmail "swoosh")}}
      {Finch, name: Swoosh.Finch}{{#if (or (ne elixirWebFramework "none") (ne elixirCaching "none") (eq elixirClustering "libcluster") (ne elixirJobs "none"))}},{{/if}}
{{/if}}
{{#if (eq elixirCaching "cachex")}}
      {Cachex, name: :{{elixirAppName}}_cache}{{#if (or (ne elixirWebFramework "none") (eq elixirClustering "libcluster") (ne elixirJobs "none"))}},{{/if}}
{{/if}}
{{#if (eq elixirCaching "nebulex")}}
      {{elixirModuleName}}.Cache{{#if (or (ne elixirWebFramework "none") (eq elixirClustering "libcluster") (ne elixirJobs "none"))}},{{/if}}
{{/if}}
{{#if (eq elixirCaching "redix")}}
      {
        Redix,
        {redis_url, name: {{elixirModuleName}}.Redix}
      }{{#if (or (ne elixirWebFramework "none") (eq elixirClustering "libcluster") (ne elixirJobs "none"))}},{{/if}}
{{/if}}
{{#if (eq elixirClustering "libcluster")}}
      {
        Cluster.Supervisor,
        [
          topologies,
          [name: {{elixirModuleName}}.ClusterSupervisor]
        ]
      }{{#if (or (ne elixirWebFramework "none") (ne elixirJobs "none"))}},{{/if}}
{{/if}}
{{#if (eq elixirJobs "oban")}}
      {Oban, oban_config}{{#if (or (ne elixirWebFramework "none"))}},{{/if}}
{{/if}}
{{#if (eq elixirJobs "quantum")}}
      {{elixirModuleName}}.Scheduler{{#if (or (ne elixirWebFramework "none"))}},{{/if}}
{{/if}}
{{#if (ne elixirWebFramework "none")}}
      {{elixirModuleName}}Web.Endpoint
{{/if}}
    ]
{{else}}
    children = []
{{/if}}

    opts = [
      strategy: :one_for_one,
      name: {{elixirModuleName}}.Supervisor
    ]

    Supervisor.start_link(children, opts)
  end

  @impl true
  def config_change(changed, _new, removed) do
{{#if (ne elixirWebFramework "none")}}
    {{elixirModuleName}}Web.Endpoint.config_change(
      changed,
      removed
    )

{{else}}
    _ = {changed, removed}
{{/if}}
    :ok
  end
end
