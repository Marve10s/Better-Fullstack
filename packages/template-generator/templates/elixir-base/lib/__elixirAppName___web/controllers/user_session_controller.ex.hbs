defmodule {{elixirModuleName}}Web.UserSessionController do
  use {{elixirModuleName}}Web, :controller

  alias {{elixirModuleName}}.Accounts

  plug :require_json_body when action in [:register, :login]
  plug :require_json_body, :allow_missing when action in [:logout]

  def register(conn, %{"user" => user_params}) do
    case Accounts.create_user(user_params) do
      {:ok, user} ->
        conn
        |> configure_session(renew: true)
        |> put_session(:user_id, user.id)
        |> put_status(:created)
        |> json(%{data: user_json(user)})

      {:error, changeset} ->
        conn
        |> put_status(:unprocessable_entity)
        |> json(%{errors: errors_json(changeset)})
    end
  end

  def login(conn, %{"user" => %{"email" => email, "password" => password}}) do
    case Accounts.get_user_by_email_and_password(email, password) do
      nil ->
        conn
        |> put_status(:unauthorized)
        |> json(%{errors: %{credentials: ["are invalid"]}})

      user ->
        conn
        |> configure_session(renew: true)
        |> put_session(:user_id, user.id)
        |> json(%{data: user_json(user)})
    end
  end

  def logout(conn, _params) do
    conn
    |> configure_session(drop: true)
    |> json(%{data: %{ok: true}})
  end

  # These actions write or clear the session cookie. Cross-site HTML forms can
  # only send urlencoded, multipart, or text/plain bodies, so requiring JSON
  # stops another site from logging a visitor in or out (login CSRF).
  # Logout may also omit Content-Type: a form always sends one, a cross-origin
  # DELETE needs a CORS preflight, and _method is only read from a parsed body.
  # Register and login stay JSON-only because a cross-site POST without a body
  # could still carry credentials in the query string.
  defp require_json_body(conn, opts) do
    case get_req_header(conn, "content-type") do
      [] when opts == :allow_missing -> conn
      [content_type | _] -> if json_content_type?(content_type), do: conn, else: reject_body(conn)
      [] -> reject_body(conn)
    end
  end

  defp json_content_type?(content_type) do
    match?({:ok, "application", "json", _params}, Plug.Conn.Utils.content_type(content_type))
  end

  defp reject_body(conn) do
    conn
    |> put_status(:unsupported_media_type)
    |> json(%{errors: %{content_type: ["must be application/json"]}})
    |> halt()
  end

  defp user_json(user) do
    %{id: user.id, email: user.email}
  end

  defp errors_json(changeset) do
    Ecto.Changeset.traverse_errors(changeset, fn {message, opts} ->
      Enum.reduce(opts, message, fn {key, value}, acc ->
        String.replace(acc, "%{#{key}}", to_string(value))
      end)
    end)
  end
end
