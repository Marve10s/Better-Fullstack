HOST=127.0.0.1
PORT={{rubyPort}}
ALLOWED_ORIGIN={{rubyWebOrigin}}
RACK_ENV=development
{{#if (or (ne rubyOrm "none") (eq rubyAuth "rodauth"))}}
DATABASE_PATH=db/development.sqlite3
{{/if}}
{{#if (eq rubyAuth "jwt")}}
JWT_SECRET=
JWT_ISSUER=better-fullstack
JWT_AUDIENCE=better-fullstack-api
{{/if}}
{{#if (or (eq rubyAuth "rodauth") (eq rubyAuth "omniauth"))}}
SESSION_SECRET=
{{/if}}
{{#if (eq rubyAuth "omniauth")}}
OIDC_ISSUER=https://issuer.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:{{rubyPort}}/auth/oidc/callback
{{/if}}
{{#if (eq rubyCache "redis")}}
REDIS_URL=redis://127.0.0.1:6379/0
{{/if}}
{{#if (eq rubyCache "memcached")}}
MEMCACHED_SERVERS=127.0.0.1:11211
{{/if}}
{{#if (or (eq rubyJobQueue "sidekiq") (eq rubyJobQueue "resque"))}}
JOBS_REDIS_URL=redis://127.0.0.1:6379/1
{{/if}}
{{#if (ne rubyEmail "none")}}
MAIL_FROM={{#if (eq rubyEmail "resend")}}Better Fullstack <onboarding@resend.dev>{{else}}Better Fullstack <noreply@example.com>{{/if}}
{{/if}}
{{#if (or (eq rubyEmail "mail") (eq rubyEmail "action-mailer"))}}
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
{{/if}}
{{#if (eq rubyEmail "resend")}}
RESEND_API_KEY=
{{/if}}
{{#if (and (ne rubyLogging "none") (ne rubyLogging "lograge"))}}
LOG_LEVEL=info
{{/if}}
{{#if (ne rubyHttpClient "none")}}
UPSTREAM_URL=http://127.0.0.1:{{rubyPort}}
{{/if}}
{{#if (eq rubyWebFramework "rails")}}
SECRET_KEY_BASE=
{{/if}}
