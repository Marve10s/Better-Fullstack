  def post_json(value)
    post "/api/greetings", JSON.generate(value), "CONTENT_TYPE" => "application/json"
  end

  def test_health
    get "/health"
    assert_equal 200, last_response.status
    assert_equal({ "status" => "ok", "service" => "{{rubyWebFramework}}" }, JSON.parse(last_response.body))
  end

  def test_greeting_trims_the_validated_name
    post_json("name" => "  Ruby  ")
    assert_equal 200, last_response.status
    assert_equal({ "greeting" => "Hello, Ruby!" }, JSON.parse(last_response.body))
  end

{{#if (ne rubyLogging "none")}}
  def test_requests_are_logged
    get "/health"
{{#if (eq rubyLogging "semantic-logger")}}
    SemanticLogger.flush
{{/if}}
    lines = File.readlines(ENV.fetch("LOG_PATH"))
{{#if (or (eq rubyLogging "logger") (eq rubyLogging "lograge"))}}
