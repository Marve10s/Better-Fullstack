  def test_invalid_request_shapes
    [nil, [], {}, { "name" => 2 }, { "name" => " " }, { "name" => "a" * 81 }, { "name" => "Ruby", "admin" => true }].each do |value|
      post_json(value)
      assert_equal 422, last_response.status
      assert JSON.parse(last_response.body).key?("error")
    end
  end

  def test_validation_error_codes
    [
      [[], "name_must_be_a_string"],
      [{ "name" => 2 }, "name_must_be_a_string"],
      [{ "name" => "Ruby", "admin" => true }, "name_must_be_a_string"],
      [{ "name" => " " }, "name_length_must_be_1_to_80"],
      [{ "name" => "a" * 81 }, "name_length_must_be_1_to_80"]
    ].each do |value, error|
      post_json(value)
      assert_equal({ "error" => error }, JSON.parse(last_response.body))
    end
  end

{{#if (ne rubyCache "none")}}
  def test_cache_serves_the_second_read_from_the_cache
    {{#if (eq rubyTesting "test-unit")}}omit{{else}}skip{{/if}} "Start the cache server to run cache tests" unless BetterFullstack::Cache.available?
    BetterFullstack::Cache.delete(BetterFullstack::Cache::KEY)
    get "/api/cache"
    first = JSON.parse(last_response.body)
    get "/api/cache"
    second = JSON.parse(last_response.body)
    assert_equal [false, true], [first.fetch("cached"), second.fetch("cached")]
    assert_equal first.fetch("value"), second.fetch("value")
  end

  def test_cache_entries_expire
    {{#if (eq rubyTesting "test-unit")}}omit{{else}}skip{{/if}} "Start the cache server to run cache tests" unless BetterFullstack::Cache.available?
    key = "better-fullstack:expiry-test"
    BetterFullstack::Cache.delete(key)
    BetterFullstack::Cache.fetch(key, ttl: 1) { "first" }
    sleep 2.1
    assert_equal ["second", false], BetterFullstack::Cache.fetch(key, ttl: 1) { "second" }
  end

