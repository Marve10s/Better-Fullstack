require "rbconfig"
{{#if (eq rubyTesting "rspec")}}
require "rspec/core/rake_task"

RSpec::Core::RakeTask.new(:test)
{{/if}}
{{#if (or (eq rubyTesting "minitest") (eq rubyTesting "test-unit"))}}
require "rake/testtask"

Rake::TestTask.new(:test) do |task|
  task.pattern = "test/**/*_test.rb"
end
{{/if}}

task :build do
  files = [*Dir["*.rb"], "config.ru", "Rakefile", *Dir["db/**/*.rb"], *Dir["test/**/*.rb"], *Dir["spec/**/*.rb"], *Dir["bin/*"]]
  files.each do |file|
    abort "Syntax check failed: #{file}" unless system(RbConfig.ruby, "-c", file)
  end
end
{{#if (or (ne rubyOrm "none") (eq rubyAuth "rodauth"))}}

namespace :db do
  desc "Apply pending database migrations"
  task :migrate do
{{#if (ne rubyOrm "none")}}
    require_relative "db"
    BetterFullstack::Database.migrate!
{{/if}}
{{#if (eq rubyAuth "rodauth")}}
    require_relative "auth"
    BetterFullstack::Auth.migrate!
{{/if}}
  end
end
{{/if}}
{{#if (ne rubyEmail "none")}}

namespace :email do
  desc "Send the welcome email to TO"
  task :welcome, [:to] do |_task, args|
    require_relative "mailer"
    puts BetterFullstack::Mailer.deliver_welcome(args.fetch(:to))
  end
end
{{/if}}
{{#if (eq rubyAuth "jwt")}}

namespace :auth do
  desc "Print a short-lived development token for SUBJECT"
  task :token, [:subject] do |_task, args|
    require_relative "auth"
    puts BetterFullstack::Auth.issue(args.with_defaults(subject: "developer")[:subject])
  end
end
{{/if}}

task default: [:build{{#if (ne rubyTesting "none")}}, :test{{/if}}]
