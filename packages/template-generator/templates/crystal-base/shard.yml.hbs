name: {{shardName}}
version: 0.1.0
crystal: ">= 1.22.1, < 1.23.0"
license: MIT
targets:
  server:
    main: src/server.cr
{{#if (or (eq crystalJobs "sidekiq") (eq crystalJobs "mosquito"))}}
  worker:
    main: src/worker.cr
{{/if}}
{{#if (or (ne crystalWebFramework "none") (ne crystalValidation "none"))}}
dependencies:
{{/if}}
{{#if (eq crystalWebFramework "kemal")}}
  kemal:
    github: kemalcr/kemal
    version: 1.15.0
{{/if}}
{{#if (eq crystalWebFramework "lucky")}}
  lucky:
    github: luckyframework/lucky
    version: 1.5.0
{{/if}}
{{#if (eq crystalWebFramework "athena")}}
  athena:
    github: athena-framework/framework
    version: 0.23.0
{{/if}}
{{#if (eq crystalWebFramework "marten")}}
  marten:
    github: martenframework/marten
    version: 0.7.1
{{/if}}
{{#if (eq crystalOrm "crystal-db")}}
  db:
    github: crystal-lang/crystal-db
    version: 0.15.0
{{/if}}
{{#if (or (eq crystalOrm "crystal-db") (eq crystalOrm "marten-orm"))}}
  sqlite3:
    github: crystal-lang/crystal-sqlite3
    version: 0.24.0
{{/if}}
{{#if (eq crystalOrm "avram")}}
  avram:
    github: luckyframework/avram
    version: 1.5.0
{{/if}}
{{#if (eq crystalAuth "jwt")}}
  jwt:
    github: crystal-community/jwt
    version: 1.7.2
{{/if}}
{{#if (eq crystalAuth "kemal-session")}}
  kemal-session:
    github: kemalcr/kemal-session
    version: 1.6.0
{{/if}}
{{#if (eq crystalAuth "marten-auth")}}
  marten_auth:
    github: martenframework/marten-auth
    version: 0.2.1
{{/if}}
{{#if (eq crystalValidation "athena-validator")}}
  athena-validator:
    github: athena-framework/validator
    version: 0.6.0
{{/if}}
{{#if (eq crystalValidation "active-model")}}
  active-model:
    github: spider-gazelle/active-model
    version: 4.7.1
{{/if}}
{{#if (or (eq crystalCache "memory") (eq crystalCache "file"))}}
  cache:
    github: crystal-cache/cache
    version: 1.1.0
{{/if}}
{{#if (eq crystalCache "redis")}}
  redis_cache_store:
    github: crystal-cache/redis_cache_store
    version: 1.1.0
{{/if}}
{{#if (eq crystalJobs "sidekiq")}}
  sidekiq:
    github: hugopl/sidekiq.cr
    version: 0.8.0
{{/if}}
{{#if (eq crystalJobs "mosquito")}}
  mosquito:
    github: mosquito-cr/mosquito
    version: 2.0.0
{{/if}}
{{#if (eq crystalJobs "tasker")}}
  tasker:
    github: spider-gazelle/tasker
    version: 3.1.0
{{/if}}
{{#if (eq crystalTesting "spectator")}}
development_dependencies:
  spectator:
    gitlab: arctic-fox/spectator
    version: 0.12.4
{{/if}}
{{#if (eq crystalTesting "spec-kemal")}}
development_dependencies:
  spec-kemal:
    github: kemalcr/spec-kemal
    version: 1.3.0
{{/if}}
