HOST=127.0.0.1
PORT=3000
{{#if (eq crystalWebFramework "kemal")}}
KEMAL_ENV=production
{{/if}}
{{#if (eq crystalWebFramework "lucky")}}
SECRET_KEY_BASE=replace-with-a-long-random-secret
{{/if}}
{{#if (eq crystalWebFramework "marten")}}
MARTEN_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost
{{/if}}
{{#if (eq crystalOrm "crystal-db")}}
DATABASE_URL=sqlite3://./development.sqlite3
{{/if}}
{{#if (eq crystalOrm "avram")}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{shardName}}_development
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{shardName}}_test
{{/if}}
{{#if (eq crystalOrm "marten-orm")}}
DATABASE_PATH=development.sqlite3
{{/if}}
{{#if (eq crystalAuth "jwt")}}
AUTH_USERNAME=demo
AUTH_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret
{{/if}}
{{#if (eq crystalAuth "kemal-session")}}
AUTH_USERNAME=demo
AUTH_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_SECURE=true
{{/if}}
{{#if (eq crystalAuth "marten-auth")}}
AUTH_USERNAME=demo@example.com
AUTH_PASSWORD=replace-with-a-long-random-password
SESSION_SECURE=true
{{/if}}
{{#if (eq crystalCache "file")}}
CACHE_DIR=tmp/cache
{{/if}}
{{#if (or (eq crystalCache "redis") (eq crystalJobs "sidekiq") (eq crystalJobs "mosquito"))}}
REDIS_URL=redis://localhost:6379/0
{{/if}}
CORS_ORIGIN=http://localhost:5173
