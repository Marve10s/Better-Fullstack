require "athena"
require "./app_config"
require "./greeting_request"
require "./http_guard"
{{#if (eq crystalAuth "jwt")}}
require "./token_auth"
{{/if}}
{{#if (ne crystalCache "none")}}
require "./cached_clock"
{{/if}}
{{#if (ne crystalJobs "none")}}
require "./greeting_jobs"
{{/if}}
{{#if (ne crystalOrm "none")}}
require "./greeting_store"
{{/if}}

class GreetingController < ATH::Controller
  @[ARTA::Get("/health")]
  def health : AHTTP::Response
    json_response GreetingRequest::Result.new(200, {status: "ok"}.to_json)
  end

  @[ARTA::Get("/api/hello")]
  def hello(request : AHTTP::Request) : AHTTP::Response
    json_response GreetingRequest.query(request.query_params["name"]?)
  end

  @[ARTA::Post("/api/echo")]
  def echo(request : AHTTP::Request) : AHTTP::Response
    json_response GreetingRequest.json(request.body.try(&.gets_to_end) || "")
  end

{{#if (ne crystalOrm "none")}}
  @[ARTA::Get("/api/greetings")]
  def greetings : AHTTP::Response
    json_response GreetingStore.list
  end

  @[ARTA::Post("/api/greetings")]
  def create_greeting(request : AHTTP::Request) : AHTTP::Response
    json_response GreetingStore.create(request.body.try(&.gets_to_end) || "")
  end

{{/if}}
{{#if (eq crystalAuth "jwt")}}
  @[ARTA::Post("/api/auth/login")]
  def login(request : AHTTP::Request) : AHTTP::Response
    json_response TokenAuth.login(request.body.try(&.gets_to_end) || "")
  end

  @[ARTA::Get("/api/me")]
  def me(request : AHTTP::Request) : AHTTP::Response
    json_response TokenAuth.current_user(request.headers["Authorization"]?)
  end

{{/if}}
{{#if (ne crystalCache "none")}}
  @[ARTA::Get("/api/cached-time")]
  def cached_time : AHTTP::Response
    json_response CachedClock.fetch
  end

{{/if}}
{{#if (ne crystalJobs "none")}}
  @[ARTA::Post("/api/jobs")]
  def enqueue_job(request : AHTTP::Request) : AHTTP::Response
    json_response GreetingJobs.enqueue(request.body.try(&.gets_to_end) || "")
  end

  @[ARTA::Get("/api/jobs")]
  def job_status(request : AHTTP::Request) : AHTTP::Response
    json_response GreetingJobs.status(request.query_params["id"]?)
  end

{{/if}}
  private def json_response(result : GreetingRequest::Result) : AHTTP::Response
    AHTTP::Response.new(result.body, result.status, HTTP::Headers{"Content-Type" => "application/json"})
  end
end

ATH.run(port: AppConfig.port, host: AppConfig.host, prepend_handlers: [HttpGuard.new] of HTTP::Handler)
