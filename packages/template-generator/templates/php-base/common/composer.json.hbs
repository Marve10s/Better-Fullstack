{
  "name": "app/{{phpPackageName}}",
{{#if (eq phpWebFramework "laravel")}}
  "description": "Laravel JSON HTTP application generated by Better Fullstack",
{{else if (eq phpWebFramework "symfony")}}
  "description": "Symfony JSON HTTP application generated by Better Fullstack",
{{else}}
  "description": "Slim JSON HTTP application generated by Better Fullstack",
{{/if}}
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "~8.5.12",
    "ext-json": "*",
{{#if (eq phpHttpClient "httplug-curl")}}
    "ext-curl": "*",
{{/if}}
{{#if (eq phpWebFramework "laravel")}}
    "ext-mbstring": "*",
    "ext-openssl": "*",
{{/if}}
{{#if (or (ne phpOrm "none") (eq phpJobQueue "symfony-messenger") (eq phpJobQueue "laravel-queue"))}}
    "ext-pdo_sqlite": "*",
{{/if}}
{{#if (eq phpOrm "cycle")}}
    "cycle/database": "~2.23.3",
    "cycle/orm": "~2.18.1",
{{/if}}
{{#if (or (eq phpAuth "firebase-jwt") (eq phpAuth "symfony-security"))}}
    "firebase/php-jwt": "~7.2.1",
{{/if}}
{{#if (and (eq phpJobQueue "symfony-messenger") (not (and (eq phpOrm "doctrine") (ne phpWebFramework "symfony"))))}}
    "doctrine/dbal": "~4.5.0",
{{/if}}
{{#if (eq phpOrm "doctrine")}}
{{#if (eq phpWebFramework "symfony")}}
    "doctrine/doctrine-bundle": "~3.3.3",
{{else}}
    "doctrine/dbal": "~4.5.0",
{{/if}}
    "doctrine/orm": "~3.7.5",
{{/if}}
{{#if (and (eq phpOrm "eloquent") (eq phpWebFramework "slim"))}}
    "illuminate/database": "~13.38.0",
{{/if}}
{{#if (eq phpJobQueue "enqueue-fs")}}
    "enqueue/fs": "~0.10.27",
{{/if}}
{{#if (eq phpHttpClient "guzzle")}}
    "guzzlehttp/guzzle": "~8.3.1",
{{/if}}
{{#if (eq phpAuth "lcobucci-jwt")}}
    "lcobucci/clock": "~3.6.0",
    "lcobucci/jwt": "~5.6.1",
{{/if}}
{{#if (eq phpCache "laminas-cache")}}
    "laminas/laminas-cache": "~4.3.0",
    "laminas/laminas-cache-storage-adapter-filesystem": "~3.2.0",
{{/if}}
{{#if (eq phpLogging "monolog")}}
    "monolog/monolog": "~3.12.1",
{{/if}}
{{#if (eq phpHttpClient "httplug-curl")}}
    "nyholm/psr7": "~1.8.2",
    "php-http/curl-client": "~2.4.0",
{{/if}}
{{#if (eq phpEmail "phpmailer")}}
    "phpmailer/phpmailer": "~7.1.1",
{{/if}}
{{#if (eq phpCache "predis")}}
    "predis/predis": "~3.7.0",
{{/if}}
{{#if (eq phpValidation "respect-validation")}}
    "respect/validation": "~3.1.2",
{{/if}}
{{#if (or (eq phpCache "symfony-cache") (and (eq phpOrm "doctrine") (eq phpWebFramework "slim")))}}
    "symfony/cache": "~8.1.9",
{{/if}}
{{#if (eq phpHttpClient "symfony-http-client")}}
    "symfony/http-client": "~8.1.9",
{{/if}}
{{#if (eq phpEmail "symfony-mailer")}}
    "symfony/mailer": "~8.1.7",
{{/if}}
{{#if (eq phpLogging "symfony-monolog")}}
    "symfony/monolog-bundle": "~4.1.0",
{{/if}}
{{#if (eq phpJobQueue "symfony-messenger")}}
    "symfony/doctrine-messenger": "~8.1.9",
    "symfony/messenger": "~8.1.9",
{{/if}}
{{#if (eq phpValidation "symfony-validator")}}
    "symfony/validator": "~8.1.9",
{{/if}}
{{#if (eq phpWebFramework "laravel")}}
    "laravel/framework": "~13.38.0"
{{else if (eq phpWebFramework "symfony")}}
    "symfony/framework-bundle": "~8.1.9"{{#if (eq phpAuth "symfony-security")}},
    "symfony/security-bundle": "~8.1.9"{{/if}}
{{else}}
    "slim/slim": "~4.15.3",
    "slim/psr7": "~1.8.0"
{{/if}}
  },
{{#if (ne phpTesting "none")}}
  "require-dev": {
{{#if (eq phpTesting "codeception")}}
    "codeception/codeception": "~5.3.7",
{{/if}}
{{#if (eq phpTesting "pest")}}
    "pestphp/pest": "~5.3.3",
{{/if}}
    "phpunit/phpunit": "~13.4.3"
  },
{{/if}}
  "autoload": {
    "psr-4": {
      "App\\": "{{phpSourceDirectory}}/"
    }
  },
{{#if (ne phpTesting "none")}}
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
{{/if}}
  "scripts": {
{{#if (eq phpWebFramework "laravel")}}
    "post-autoload-dump": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
{{/if}}
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "@php bin/serve.php"
    ],
    "build": [
      "@composer validate --strict",
      "@php bin/check.php",
      "@composer dump-autoload --optimize --strict-psr"
    ],
{{#if (eq phpTesting "pest")}}
    "test": "@php vendor/bin/pest tests",
{{else if (eq phpTesting "codeception")}}
    "test": "@php vendor/bin/codecept run Unit",
{{else if (eq phpTesting "phpunit")}}
    "test": "@php vendor/bin/phpunit --bootstrap vendor/autoload.php tests",
{{/if}}
{{#if (ne phpAuth "none")}}
    "token:issue": "@php bin/issue-token.php",
{{/if}}
{{#if (eq phpEmail "laravel-mail")}}
    "mail:send": "@php artisan mail:send",
{{else if (ne phpEmail "none")}}
    "mail:send": "@php bin/send-mail.php",
{{/if}}
{{#if (eq phpJobQueue "laravel-queue")}}
    "queue:work": [
      "Composer\\Config::disableProcessTimeout",
      "@php artisan queue:work"
    ],
{{else if (ne phpJobQueue "none")}}
    "queue:work": [
      "Composer\\Config::disableProcessTimeout",
      "@php bin/queue-work.php"
    ],
{{/if}}
{{#if (or (ne phpOrm "none") (eq phpJobQueue "laravel-queue"))}}
{{#if (eq phpWebFramework "laravel")}}
    "db:setup": "@php artisan migrate --force --no-interaction",
{{else}}
    "db:setup": "@php bin/db-setup.php",
{{/if}}
{{/if}}
    "proof:http": "@php bin/proof-http.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  }
}
