{{#if (eq phpWebFramework "laravel")}}
APP_ENV=local
APP_KEY=
{{else if (eq phpWebFramework "symfony")}}
APP_ENV=prod
APP_DEBUG=0
{{/if}}
HOST=127.0.0.1
PORT=8080
CORS_ORIGIN=
{{#if (ne phpAuth "none")}}
JWT_SECRET=
JWT_ISSUER=better-fullstack
JWT_AUDIENCE=api
{{/if}}
{{#if (ne phpCache "none")}}
CACHE_NAMESPACE=app
{{/if}}
{{#if (eq phpCache "predis")}}
REDIS_URL=tcp://127.0.0.1:6379
{{/if}}
{{#if (eq phpJobQueue "laravel-queue")}}
CACHE_STORE=file
QUEUE_CONNECTION=database
{{/if}}
{{#if (eq phpEmail "symfony-mailer")}}
MAILER_DSN=smtp://127.0.0.1:1025
MAIL_FROM_ADDRESS=hello@example.com
{{else if (eq phpEmail "phpmailer")}}
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=hello@example.com
{{else if (eq phpEmail "laravel-mail")}}
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS=hello@example.com
{{/if}}
{{#if (eq phpLogging "monolog")}}
LOG_LEVEL=info
{{else if (eq phpLogging "symfony-monolog")}}
LOG_PATH=php://stderr
{{else if (eq phpLogging "laravel-log")}}
LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=info
{{/if}}
{{#if (ne phpHttpClient "none")}}
UPSTREAM_URL=
{{/if}}
