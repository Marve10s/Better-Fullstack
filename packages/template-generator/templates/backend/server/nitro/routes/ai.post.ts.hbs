// The AI route trusts the session cookie, so accept JSON only, and only from the configured web
// origin or with no Origin (native apps, servers), to stop cross-site posts that skip preflight.
function isTrustedAiRequest(origin: string | undefined, contentType: string | undefined) {
	return (!origin || origin === env.CORS_ORIGIN) && /^application\/json\s*(;|$)/i.test(contentType ?? "");
}

