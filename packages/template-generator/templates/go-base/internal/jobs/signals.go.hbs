package jobs

import (
	"os"
	"os/signal"
	"syscall"
)

func StopOnSignal(runner *Runner) {
	signals := make(chan os.Signal, 1)
	signal.Notify(signals, os.Interrupt, syscall.SIGTERM)
	go func() {
		<-signals
		runner.Stop()
		os.Exit(0)
	}()
}
