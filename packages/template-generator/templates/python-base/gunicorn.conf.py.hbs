{{#if (and (eq pythonServer "gunicorn") (ne pythonLogging "none"))}}
"""Gunicorn settings: send Gunicorn's own logs through the app's logging setup."""

from typing import Any

from gunicorn.glogging import Logger

from app.logging_config import configure_logging


class AppLogger(Logger):
    """Gunicorn logger whose output is handled by app.logging_config."""

    def setup(self, cfg: Any) -> None:
        super().setup(cfg)
        configure_logging()


logger_class = AppLogger


def post_fork(server: Any, worker: Any) -> None:
    """Configure logging again in each worker process.

    With --preload the app is imported once in the master, so its own setup does
    not run in the workers, and Uvicorn's worker class detaches its loggers from
    the root handler before the fork.
    """
    configure_logging()
{{/if}}
