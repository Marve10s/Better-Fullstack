{{#if (includes pythonData "numpy")}}

import numpy as np


def normalize(values: list[float]) -> list[float]:
    """Scale numeric values to the 0..1 range with NumPy."""
    array = np.asarray(values, dtype=float)
    spread = float(np.ptp(array))
    if spread == 0:
        return np.zeros_like(array).tolist()
    return ((array - array.min()) / spread).tolist()
