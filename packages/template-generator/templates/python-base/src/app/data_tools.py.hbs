{{#if (includes pythonData "pandas")}}

import pandas as pd


def records_to_dataframe(records: list[dict[str, object]]) -> pd.DataFrame:
    """Create a pandas DataFrame from API or database records."""
    return pd.DataFrame.from_records(records)
