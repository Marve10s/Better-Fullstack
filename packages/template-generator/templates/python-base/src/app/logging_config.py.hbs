class RequestLoggingMiddleware:
    """WSGI middleware that logs each request once and tags its log lines with a request id."""

    def __init__(self, app: "WSGIApplication") -> None:
        self.app = app

    def __call__(
        self, environ: "WSGIEnvironment", start_response: "StartResponse"
    ) -> Iterable[bytes]:
        request_id = _request_id(environ.get("HTTP_X_REQUEST_ID"))
        status_code = 500
        started = time.perf_counter()

        def start_response_with_request_id(
            status: str, headers: list[tuple[str, str]], exc_info: "OptExcInfo | None" = None
        ) -> Callable[[bytes], object]:
            nonlocal status_code
            status_code = int(status.split(" ", 1)[0])
            return start_response(status, [*headers, (REQUEST_ID_HEADER, request_id)], exc_info)

        with request_context(request_id):
            try:
                return self.app(environ, start_response_with_request_id)
            finally:
                _log_request(
                    environ.get("REQUEST_METHOD", ""),
                    environ.get("PATH_INFO", ""),
                    status_code,
                    started,
                )


