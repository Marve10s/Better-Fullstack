def _log_settings() -> tuple[str, bool]:
    """Return the log level and whether to write JSON."""
{{#if (eq pythonValidation "pydantic")}}
    settings = get_settings()
    level, log_format, app_env = settings.log_level, settings.log_format, settings.app_env
{{else}}
    load_dotenv()
    level = os.getenv("LOG_LEVEL", "INFO")
    log_format = os.getenv("LOG_FORMAT", "auto")
    app_env = os.getenv("APP_ENV", "development")
{{/if}}
    use_json = log_format == "json" or (log_format == "auto" and app_env == "production")
    return level.upper(), use_json


def _route_stdlib_loggers() -> None:
    """Send every existing standard library logger through the root handler."""
    for existing in list(logging.root.manager.loggerDict.values()):
        if isinstance(existing, logging.Logger):
            existing.handlers.clear()
            existing.propagate = True
    for name in _QUIET_LOGGERS:
        logging.getLogger(name).setLevel(logging.WARNING)


def _write_stdout(text: str) -> None:
    # Look up sys.stdout on every write: servers and test runners replace it.
    sys.stdout.write(text)
    sys.stdout.flush()
