class InterceptHandler(logging.Handler):
    """Forward standard library records to Loguru."""

    def emit(self, record: logging.LogRecord) -> None:
        level: str | int
        try:
            level = logger.level(record.levelname).name
        except ValueError:
            level = record.levelno

        frame, depth = inspect.currentframe(), 0
        while frame is not None and (depth == 0 or frame.f_code.co_filename == logging.__file__):
            frame = frame.f_back
            depth += 1

        logger.bind(logger_name=record.name).opt(depth=depth, exception=record.exc_info).log(
            level, record.getMessage()
        )


def _patch_record(record: "Record") -> None:
    record["extra"].setdefault("logger_name", record["name"])
{{#if (or (eq pythonObservability "opentelemetry") (eq pythonObservability "signoz"))}}
    span_context = trace.get_current_span().get_span_context()
    if span_context.is_valid:
        record["extra"]["trace_id"] = format(span_context.trace_id, "032x")
        record["extra"]["span_id"] = format(span_context.span_id, "016x")
{{/if}}


def _console_format(record: "Record") -> str:
    template = (
        "<green>{time:YYYY-MM-DD HH:mm:ss.SSS}</green> | <level>{level: <8}</level> | "
        "<cyan>{extra[logger_name]}</cyan>"
    )
    if "request_id" in record["extra"]:
        template += " [{extra[request_id]}]"
    return template + " - <level>{message}</level>\n{exception}"


def _json_sink(message: "LogMessage") -> None:
    record = message.record
    extra = dict(record["extra"])
    payload: dict[str, object] = {
        "timestamp": record["time"].isoformat(),
        "level": record["level"].name,
        "logger": extra.pop("logger_name", record["name"]),
        "message": record["message"],
        **extra,
    }
    exception = record["exception"]
    if exception is not None:
        payload["exception"] = "".join(
            traceback.format_exception(exception.type, exception.value, exception.traceback)
        )
    _write_stdout(json.dumps(payload, default=str) + "\n")


def configure_logging() -> None:
    """Install Loguru as the single log output for the app, framework, and server."""
    level, use_json = _log_settings()
    logger.remove()
    if use_json:
        logger.add(_json_sink, level=level, backtrace=False, diagnose=False)
    else:
        logger.add(_write_stdout, level=level, format=_console_format, colorize=sys.stdout.isatty())
    logger.configure(patcher=_patch_record)
    logging.basicConfig(handlers=[InterceptHandler()], level=level, force=True)
    _route_stdlib_loggers()
