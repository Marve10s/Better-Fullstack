def request_logging_middleware(get_response: Callable[[Any], Any]) -> Callable[[Any], Any]:
    """Django middleware that logs each request once and tags its log lines with a request id."""

    def middleware(request: Any) -> Any:
        request_id = _request_id(request.headers.get(REQUEST_ID_HEADER))
        started = time.perf_counter()
        with request_context(request_id):
            response = get_response(request)
            response[REQUEST_ID_HEADER] = request_id
            _log_request(request.method or "", request.path, response.status_code, started)
        return response

    return middleware
{{/if}}
{{#if (eq pythonWebFramework "aiohttp")}}


@web.middleware
async def request_logging_middleware(request: web.Request, handler: Handler) -> web.StreamResponse:
    """Log each request once and tag its log lines with a request id."""
    request_id = _request_id(request.headers.get(REQUEST_ID_HEADER))
    status_code = 500
    started = time.perf_counter()
    with request_context(request_id):
        try:
            response = await handler(request)
            status_code = response.status
            if not response.prepared:
                response.headers[REQUEST_ID_HEADER] = request_id
            return response
        except web.HTTPException as exc:
            status_code = exc.status
            exc.headers[REQUEST_ID_HEADER] = request_id
            raise
        finally:
            _log_request(request.method, request.path, status_code, started)
