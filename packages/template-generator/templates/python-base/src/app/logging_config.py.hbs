def _request_id(incoming: str | None) -> str:
    """Reuse a well-formed incoming request id, otherwise create one."""
    if incoming and len(incoming) <= 128 and incoming.isascii() and incoming.isprintable():
        return incoming
    return uuid.uuid4().hex
