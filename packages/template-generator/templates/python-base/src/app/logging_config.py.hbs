@contextmanager
def request_context(request_id: str) -> Generator[None, None, None]:
    """Attach the request id to every log line written inside the block."""
    with logger.contextualize(request_id=request_id):
        yield


def _log_request(method: str, path: str, status_code: int, started: float) -> None:
    duration_ms = round((time.perf_counter() - started) * 1000, 2)
    logger.log(
        "ERROR" if status_code >= 500 else "INFO",
        "{method} {path} {status_code} ({duration_ms} ms)",
        method=method,
        path=path,
        status_code=status_code,
        duration_ms=duration_ms,
    )
