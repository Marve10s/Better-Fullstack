# Environment Configuration
# Copy this file to .env and update the values

# Application
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Allowed web origin for CORS (unset or empty = allow any origin)
CORS_ORIGIN=

# Database (if using SQLAlchemy/SQLModel)
{{#if (eq pythonOrm "pymongo")}}
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE={{projectName}}
{{else}}
{{#if (eq database "postgres")}}
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/{{projectName}}
{{else}}
DATABASE_URL=sqlite:///./app.db
{{/if}}
{{/if}}

# OpenAI (if using AI frameworks)
OPENAI_API_KEY=your-openai-api-key

# Anthropic (if using Anthropic SDK)
ANTHROPIC_API_KEY=your-anthropic-api-key
{{#if (includes pythonAi "transformers")}}

# Hugging Face Transformers
HF_MODEL_ID=distilgpt2
{{/if}}
{{#if (or (eq pythonAuth "authlib") (or (eq pythonAuth "jwt") (eq pythonAuth "pyjwt")))}}

# JWT signing
SECRET_KEY=change-me-to-a-long-random-secret
{{/if}}
{{#if (eq pythonCloudSdk "boto3")}}

# AWS SDK (credentials use the standard AWS credential chain)
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=default
{{/if}}
{{#if (eq pythonMessageQueue "confluent-kafka")}}

# Confluent Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
{{/if}}

# Celery (if using task queue)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
{{#if (eq pythonCaching "redis")}}

# redis-py caching
REDIS_URL=redis://127.0.0.1:6379/0
{{/if}}
{{#if (eq pythonObservability "opentelemetry")}}

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
{{/if}}
{{#if (eq pythonAuth "fastapi-users")}}

# FastAPI Users
AUTH_SECRET=change-me-to-a-real-secret
USERS_DATABASE_URL=sqlite+aiosqlite:///./users.db
{{/if}}
{{#if (eq pythonRealtime "websockets")}}

# websockets server
WS_HOST=0.0.0.0
WS_PORT=8765
{{/if}}
