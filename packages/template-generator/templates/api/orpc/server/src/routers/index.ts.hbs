{{#if (eq api "orpc")}}
import { {{#if (hasApiSession auth)}}protectedProcedure, {{/if}}publicProcedure } from "../index{{#if (eq backend "adonisjs")}}.js{{/if}}";
import type { RouterClient } from "@orpc/server";
{{#if (and (includes examples "tanstack-showcase") (eq orm "drizzle") (or (includes frontend "solid-start") (includes frontend "tanstack-start-solid")) (or (isBetterAuth auth) (eq auth "none")))}}
import { tasksRouter } from "./tasks";
{{/if}}

export const appRouter = {
  healthCheck: publicProcedure.handler(() => {
    return "OK";
  }),
  {{#if (and (includes examples "tanstack-showcase") (eq orm "drizzle") (or (includes frontend "solid-start") (includes frontend "tanstack-start-solid")) (or (isBetterAuth auth) (eq auth "none")))}}
  tasks: tasksRouter,
  {{/if}}
  {{#if (hasApiSession auth)}}
  privateData: protectedProcedure.handler(({ context }) => {
    return {
      message: "This is private",
      user: context.session?.user,
    };
  }),
  {{/if}}
};
export type AppRouter = typeof appRouter;
export type AppRouterClient = RouterClient<typeof appRouter>;
{{else if (eq api "trpc")}}
import {
  {{#if (hasApiSession auth)}}protectedProcedure, {{/if}}publicProcedure,
  router,
} from "../index{{#if (eq backend "adonisjs")}}.js{{/if}}";

export const appRouter = router({
  healthCheck: publicProcedure.query(() => {
    return "OK";
  }),
  {{#if (hasApiSession auth)}}
  privateData: protectedProcedure.query(({ ctx }) => {
    return {
      message: "This is private",
      user: ctx.session.user,
    };
  }),
  {{/if}}
});
export type AppRouter = typeof appRouter;
{{else}}
export const appRouter = {};
export type AppRouter = typeof appRouter;
{{/if}}
