{{#if (eq api "orpc")}}
import { {{#if (isBetterAuth auth)}}protectedProcedure, {{/if}}publicProcedure } from "../index{{#if (eq backend "adonisjs")}}.js{{/if}}";
import type { RouterClient } from "@orpc/server";

// <better-fullstack:recipe-imports sha256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855>

// </better-fullstack:recipe-imports>

export const appRouter = {
  // <better-fullstack:recipe-registrations sha256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855>

  // </better-fullstack:recipe-registrations>
  healthCheck: publicProcedure.handler(() => {
    return "OK";
  }),
  {{#if (isBetterAuth auth)}}
  privateData: protectedProcedure.handler(({ context }) => {
    return {
      message: "This is private",
      user: context.session?.user,
    };
  }),
  {{/if}}
};
export type AppRouter = typeof appRouter;
export type AppRouterClient = RouterClient<typeof appRouter>;
{{else if (eq api "trpc")}}
import {
  {{#if (isBetterAuth auth)}}protectedProcedure, {{/if}}publicProcedure,
  router,
} from "../index{{#if (eq backend "adonisjs")}}.js{{/if}}";

// <better-fullstack:recipe-imports sha256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855>

// </better-fullstack:recipe-imports>

export const appRouter = router({
  // <better-fullstack:recipe-registrations sha256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855>

  // </better-fullstack:recipe-registrations>
  healthCheck: publicProcedure.query(() => {
    return "OK";
  }),
  {{#if (isBetterAuth auth)}}
  privateData: protectedProcedure.query(({ ctx }) => {
    return {
      message: "This is private",
      user: ctx.session.user,
    };
  }),
  {{/if}}
});
export type AppRouter = typeof appRouter;
{{else}}
export const appRouter = {};
export type AppRouter = typeof appRouter;
{{/if}}
