import { createFileRoute } from "@tanstack/react-router";
import { createYoga } from "graphql-yoga";
import { schema } from "@{{projectName}}/api";
import { createContext } from "@{{projectName}}/api/context";
{{#if (isBetterAuth auth)}}
import { auth } from "@{{projectName}}/auth";
{{/if}}

const yoga = createYoga({
  graphqlEndpoint: "/api/graphql",
  fetchAPI: { Response },
  context: async ({{#if (isBetterAuth auth)}}{ request }{{/if}}) => {
{{#if (isBetterAuth auth)}}
    const session = await auth.api.getSession({
      headers: request.headers,
    });
    return createContext(session);
{{else}}
    return createContext();
{{/if}}
  },
});

export const Route = createFileRoute("/api/graphql")({
  server: {
    handlers: {
      GET: async ({ request }) => yoga.handleRequest(request, {}),
      POST: async ({ request }) => yoga.handleRequest(request, {}),
    },
  },
});
