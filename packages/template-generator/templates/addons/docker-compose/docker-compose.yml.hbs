name: {{projectName}}

services:
{{#if (includes addons "kong")}}
  kong:
    image: kong/kong-gateway:3.15.0.1
    environment:
      KONG_DATABASE: "off"
      KONG_DECLARATIVE_CONFIG: /kong/declarative/kong.yml
      KONG_PROXY_ACCESS_LOG: /dev/stdout
      KONG_PROXY_ERROR_LOG: /dev/stderr
      KONG_ADMIN_ACCESS_LOG: /dev/stdout
      KONG_ADMIN_ERROR_LOG: /dev/stderr
      KONG_ADMIN_LISTEN: 0.0.0.0:8001
    ports:
      - "8000:8000"
      - "127.0.0.1:8001:8001"
    volumes:
      - ./kong/kong.yml:/kong/declarative/kong.yml:ro
    depends_on:
{{#if (eq ecosystem "typescript")}}
{{#if (eq backend "self")}}
      - web
{{else}}
      - server
{{/if}}
{{else}}
      - app
{{/if}}
    restart: unless-stopped

{{/if}}
{{#if (eq ecosystem "typescript")}}
  web:
    build:
      context: .
{{#if (or (includes frontend "next") (includes frontend "vinext"))}}
      dockerfile: apps/web/Dockerfile.next
{{#if (includes addons "kong")}}
      args:
        NEXT_PUBLIC_SERVER_URL: http://localhost:8000
{{/if}}
{{else}}
      dockerfile: apps/web/Dockerfile.vite
      args:
{{#if (includes addons "kong")}}
        VITE_SERVER_URL: http://localhost:8000
{{else}}
        VITE_SERVER_URL: http://localhost:3000
{{/if}}
{{/if}}
    ports:
      - "3001:3000"
    environment:
      - NODE_ENV=production
{{#if (eq backend "self")}}
{{#if (eq database "postgres")}}
      - DATABASE_URL=postgresql://postgres:postgres@db:5432/{{projectName}}
{{else if (eq database "mysql")}}
      - DATABASE_URL=mysql://root:rootpassword@db:3306/{{projectName}}
{{else if (eq database "mongodb")}}
      - DATABASE_URL=mongodb://root:password@db:27017/{{projectName}}?authSource=admin
{{/if}}
{{/if}}
{{#unless (eq backend "self")}}
{{#unless (eq backend "none")}}
    depends_on:
      - server
{{/unless}}
{{/unless}}
{{#if (eq backend "self")}}
{{#if (or (or (eq database "postgres") (eq database "mysql")) (eq database "mongodb"))}}
    depends_on:
      db:
        condition: service_healthy
{{/if}}
{{/if}}
    restart: unless-stopped

{{#unless (eq backend "self")}}
{{#unless (eq backend "none")}}
  server:
    build:
      context: .
      dockerfile: apps/server/Dockerfile
    ports:
      - "3000:3000"
    environment:
      - NODE_ENV=production
      - PORT=3000
      - CORS_ORIGIN=http://localhost:3001
{{#if (eq database "postgres")}}
      - DATABASE_URL=postgresql://postgres:postgres@db:5432/{{projectName}}
{{else if (eq database "mysql")}}
      - DATABASE_URL=mysql://root:rootpassword@db:3306/{{projectName}}
{{else if (eq database "mongodb")}}
      - DATABASE_URL=mongodb://root:password@db:27017/{{projectName}}?authSource=admin
{{/if}}
{{#if (or (or (eq database "postgres") (eq database "mysql")) (eq database "mongodb"))}}
    depends_on:
      db:
        condition: service_healthy
{{/if}}
    restart: unless-stopped
{{/unless}}
{{/unless}}

{{#if (eq database "postgres")}}
  db:
    image: postgres:16-alpine
    container_name: {{projectName}}-postgres
    # WARNING: Configure database credentials via environment variables before production use.
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-{{projectNameWithClosingBrace}}
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-postgres}
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped

volumes:
  postgres_data:
{{/if}}
{{#if (eq database "mysql")}}
  db:
    image: mysql:8
    container_name: {{projectName}}-mysql
    # WARNING: Configure database credentials via environment variables before production use.
    environment:
      MYSQL_DATABASE: {{projectName}}
      MYSQL_USER: ${MYSQL_USER:-user}
      MYSQL_PASSWORD: ${MYSQL_PASSWORD:-password}
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD:-rootpassword}
    ports:
      - "3306:3306"
    volumes:
      - mysql_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped

volumes:
  mysql_data:
{{/if}}
{{#if (eq database "mongodb")}}
  db:
    image: mongo:7
    container_name: {{projectName}}-mongodb
    # WARNING: Configure database credentials via environment variables before production use.
    environment:
      MONGO_INITDB_ROOT_USERNAME: ${MONGO_INITDB_ROOT_USERNAME:-root}
      MONGO_INITDB_ROOT_PASSWORD: ${MONGO_INITDB_ROOT_PASSWORD:-password}
      MONGO_INITDB_DATABASE: {{projectName}}
    ports:
      - "27017:27017"
    volumes:
      - mongo_data:/data/db
    healthcheck:
      test: ["CMD", "mongosh", "--eval", "db.adminCommand('ping')"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped

volumes:
  mongo_data:
{{/if}}
{{else}}
{{#if graphWebFrontend}}
  web:
    build:
      context: .
{{#if (or (includes frontend "next") (includes frontend "vinext"))}}
      dockerfile: apps/web/Dockerfile.next
      args:
        NEXT_PUBLIC_SERVER_URL: http://localhost:8000
{{else}}
      dockerfile: apps/web/Dockerfile.vite
      args:
        VITE_SERVER_URL: http://localhost:8000
{{/if}}
    ports:
      - "3001:3000"
    environment:
      - NODE_ENV=production
    depends_on:
      - app
    restart: unless-stopped

{{/if}}
  app:
    build:
{{#if graphBackendTargetPath}}
      context: {{graphBackendTargetPath}}
      dockerfile: Dockerfile
{{else}}
      context: .
      dockerfile: Dockerfile
{{/if}}
    ports:
{{#if (eq ecosystem "python")}}
{{#unless (includes addons "kong")}}
      - "8000:8000"
{{/unless}}
{{else if (eq ecosystem "rust")}}
      - "3000:3000"
{{#if (eq rustApi "tonic")}}
      - "50051:50051"
{{/if}}
{{#if (eq rustApi "jsonrpsee")}}
      - "9944:9944"
{{/if}}
{{#if (eq rustObservability "metrics")}}
      - "9000:9000"
{{/if}}
{{else}}
      - "8080:8080"
{{/if}}
    environment:
{{#if graphWebFrontend}}
      - CORS_ORIGIN=http://localhost:3001
{{/if}}
{{#if (eq ecosystem "python")}}
      - HOST=0.0.0.0
      - PORT=8000
{{#if (and (ne pythonOrm "none") (eq database "postgres"))}}
{{#if (eq pythonOrm "tortoise-orm")}}
      - DATABASE_URL=postgres://postgres:postgres@db:5432/{{projectName}}
{{else}}
      - DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/{{projectName}}
{{/if}}
{{/if}}
{{#if (and (ne pythonOrm "none") (eq database "mongodb"))}}
      - MONGODB_URI=mongodb://root:password@db:27017/{{projectName}}?authSource=admin
{{/if}}
{{else if (eq ecosystem "go")}}
      - HOST=0.0.0.0
      - PORT=8080
{{#if (ne goOrm "none")}}
      - DATABASE_URL=postgres://postgres:postgres@db:5432/{{projectName}}?sslmode=disable
{{/if}}
{{else if (eq ecosystem "rust")}}
      - HOST=0.0.0.0
      - PORT=3000
{{#if (eq rustApi "tonic")}}
      - GRPC_PORT=50051
{{/if}}
{{#if (eq rustApi "jsonrpsee")}}
      - JSONRPC_PORT=9944
{{/if}}
{{#if (eq rustObservability "metrics")}}
      - METRICS_LISTEN_ADDRESS=0.0.0.0:9000
{{/if}}
{{#if (eq rustOrm "mongodb")}}
      - MONGODB_URI=mongodb://root:password@db:27017/{{projectName}}?authSource=admin
{{else if (eq rustOrm "rusqlite")}}
      - DATABASE_URL=/app/data/data.db
{{else if (ne rustOrm "none")}}
      - DATABASE_URL=postgres://postgres:postgres@db:5432/{{projectName}}
{{/if}}
{{else if (eq ecosystem "java")}}
      - PORT=8080
      - SPRING_PROFILES_ACTIVE=prod
{{/if}}
{{#if (or (or (and (eq ecosystem "python") (and (ne pythonOrm "none") (or (eq database "postgres") (eq database "mongodb")))) (and (eq ecosystem "go") (ne goOrm "none"))) (and (eq ecosystem "rust") (and (ne rustOrm "none") (ne rustOrm "rusqlite"))))}}
    depends_on:
      db:
        condition: service_healthy
{{/if}}
{{#if (and (eq ecosystem "rust") (eq rustOrm "rusqlite"))}}
    volumes:
      - rust_sqlite_data:/app/data
{{/if}}
    restart: unless-stopped

{{#if (or (or (and (eq ecosystem "python") (and (ne pythonOrm "none") (or (eq database "postgres") (eq database "mongodb")))) (and (eq ecosystem "go") (ne goOrm "none"))) (and (eq ecosystem "rust") (and (ne rustOrm "none") (ne rustOrm "rusqlite"))))}}
  db:
{{#if (or (and (eq ecosystem "rust") (eq rustOrm "mongodb")) (and (eq ecosystem "python") (eq database "mongodb")))}}
    image: mongo:7
    container_name: {{projectName}}-mongodb
    environment:
      MONGO_INITDB_ROOT_USERNAME: ${MONGO_INITDB_ROOT_USERNAME:-root}
      MONGO_INITDB_ROOT_PASSWORD: ${MONGO_INITDB_ROOT_PASSWORD:-password}
      MONGO_INITDB_DATABASE: ${MONGO_INITDB_DATABASE:-{{projectNameWithClosingBrace}}
    ports:
      - "27017:27017"
    volumes:
      - mongodb_data:/data/db
    healthcheck:
      test: ["CMD", "mongosh", "--eval", "db.adminCommand('ping')"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped
{{else}}
    image: postgres:16-alpine
    container_name: {{projectName}}-postgres
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-{{projectNameWithClosingBrace}}
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-postgres}
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped
{{/if}}

volumes:
{{#if (or (and (eq ecosystem "rust") (eq rustOrm "mongodb")) (and (eq ecosystem "python") (eq database "mongodb")))}}
  mongodb_data:
{{else}}
  postgres_data:
{{/if}}
{{/if}}
{{#if (and (eq ecosystem "rust") (eq rustOrm "rusqlite"))}}
volumes:
  rust_sqlite_data:
{{/if}}
{{/if}}
