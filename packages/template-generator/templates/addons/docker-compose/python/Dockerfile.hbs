FROM python:3.12-slim AS app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.9.17 /uv /uvx /usr/local/bin/

COPY pyproject.toml ./
RUN uv sync --no-dev --no-install-project

COPY . .
RUN if [ -f uv.lock ]; then \
      uv sync --frozen --no-dev; \
    else \
      uv sync --no-dev; \
    fi

ENV PATH="/app/.venv/bin:$PATH" \
    HOST=0.0.0.0 \
    PORT=8000

EXPOSE 8000

{{#if (eq pythonServer "gunicorn")}}
{{#if (eq pythonWebFramework "aiohttp")}}
CMD ["gunicorn", "app.main:app", "--worker-class", "aiohttp.GunicornWebWorker", "--bind", "0.0.0.0:8000"]
{{else if (eq pythonWebFramework "django")}}
CMD ["gunicorn", "app.main:application", "--bind", "0.0.0.0:8000"]
{{else if (eq pythonWebFramework "flask")}}
CMD ["gunicorn", "app.main:app", "--bind", "0.0.0.0:8000"]
{{else}}
CMD ["gunicorn", "app.main:app", "--worker-class", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8000"]
{{/if}}
{{else if (eq pythonWebFramework "litestar")}}
CMD ["litestar", "--app", "app.main:app", "run", "--host", "0.0.0.0", "--port", "8000"]
{{else if (eq pythonWebFramework "streamlit")}}
CMD ["streamlit", "run", "src/app/main.py", "--server.address", "0.0.0.0", "--server.port", "8000"]
{{else}}
CMD ["python", "-m", "app.main"]
{{/if}}
