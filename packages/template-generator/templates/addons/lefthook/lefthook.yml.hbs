# Lefthook configuration
# https://github.com/evilmartians/lefthook

pre-commit:
  parallel: true
  jobs:
{{#if (includes addons "gitleaks")}}
    - name: gitleaks
      run: gitleaks git --pre-commit --redact --staged --verbose
{{/if}}
{{#if (includes addons "biome")}}
    - name: biome
      glob: "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}"
      run: {{#if (eq packageManager "npm")}}npm exec{{else}}{{packageManager}}{{/if}} biome check --write --no-errors-on-unmatched --files-ignore-unknown=true {staged_files}
      stage_fixed: true
{{else if (includes addons "oxlint")}}
    - name: oxlint
      run: {{#if (eq packageManager "npm")}}npm exec{{else}}{{packageManager}}{{/if}} oxlint --fix {staged_files}
      stage_fixed: true
    - name: oxfmt
      run: {{#if (eq packageManager "npm")}}npm exec{{else}}{{packageManager}}{{/if}} oxfmt --write {staged_files}
      stage_fixed: true
{{else}}
    # Add your pre-commit commands here
    # Example:
    # - name: lint
    #   run: {{packageManagerRunCmd}} lint
{{/if}}
