# Railway configuration for {{projectName}} server
# See https://docs.railway.app/reference/config-as-code for all options
#
# Keep the service root directory at the repository root and set the config file
# path to /apps/server/railway.toml. The image runs the server with its own CMD.

[build]
builder = "dockerfile"
dockerfilePath = "apps/server/Dockerfile"

[deploy]
healthcheckPath = "/"
healthcheckTimeout = 300
restartPolicyType = "on_failure"
restartPolicyMaxRetries = 3
