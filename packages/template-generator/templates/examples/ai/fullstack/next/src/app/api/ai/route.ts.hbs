{{#*inline "requireUser"}}
{{#if (hasAiRouteAuth auth backend frontend)}}
// No CORS headers are served, so a JSON request from another site needs a preflight that fails;
// only non-JSON form posts reach this route cross-site, and they are rejected here.
if (!/^application\/json\s*(;|$)/i.test(req.headers.get("content-type") ?? "")) {
	return Response.json({ message: "Expected a JSON request" }, { status: 415 });
}
{{/if}}
{{#if (isBetterAuth auth)}}
const session = await auth.api.getSession({ headers: req.headers });
if (!session) {
	return Response.json({ message: "Unauthorized" }, { status: 401 });
}

{{else if (eq auth "clerk")}}
const { userId } = await auth();
if (!userId) {
	return Response.json({ message: "Unauthorized" }, { status: 401 });
}

{{else if (eq auth "nextauth")}}
const session = await auth();
if (!session?.user) {
	return Response.json({ message: "Unauthorized" }, { status: 401 });
}

{{else if (eq auth "stack-auth")}}
const user = await stackServerApp.getUser();
if (!user) {
	return Response.json({ message: "Unauthorized" }, { status: 401 });
}

{{else if (eq auth "supabase-auth")}}
const supabase = await createClient();
const {
	data: { user },
} = await supabase.auth.getUser();
if (!user) {
	return Response.json({ message: "Unauthorized" }, { status: 401 });
}

{{else if (eq auth "auth0")}}
const session = await auth0.getSession();
if (!session) {
	return Response.json({ message: "Unauthorized" }, { status: 401 });
}

{{/if}}
