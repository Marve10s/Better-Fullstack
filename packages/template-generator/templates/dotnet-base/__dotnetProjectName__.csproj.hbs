<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="**/*.Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
{{#if dotnetHasEfCore}}
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" PrivateAssets="all" />
{{#if (eq database "postgres")}}
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
{{else}}
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
{{/if}}
{{/if}}
{{#if dotnetHasDapper}}
    <PackageReference Include="Dapper" Version="2.1.79" />
{{#if (eq database "postgres")}}
    <PackageReference Include="Npgsql" Version="10.0.3" />
{{else}}
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
{{/if}}
{{/if}}
{{#if dotnetHasLinq2Db}}
    <PackageReference Include="linq2db" Version="6.2.1" />
{{#if (eq database "postgres")}}
    <PackageReference Include="Npgsql" Version="10.0.3" />
{{else}}
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
{{/if}}
{{/if}}
{{#if dotnetHasIdentity}}
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
{{/if}}
{{#if dotnetHasAuth0AspNet}}
    <PackageReference Include="Auth0.AspNetCore.Authentication" Version="1.7.1" />
{{/if}}
{{#if dotnetHasDuendeIdentityServer}}
    <PackageReference Include="Duende.IdentityServer" Version="8.0.2" />
{{/if}}
{{#if (eq dotnetApi "graphql-hotchocolate")}}
    <PackageReference Include="HotChocolate.AspNetCore" Version="16.0.0" />
{{/if}}
{{#if (eq dotnetValidation "fluentvalidation")}}
    <PackageReference Include="FluentValidation" Version="12.1.1" />
{{/if}}
{{#if (eq dotnetApi "grpc-dotnet")}}
    <PackageReference Include="Grpc.AspNetCore" Version="2.71.0" />
{{/if}}
{{#if dotnetHasSerilog}}
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
{{/if}}
{{#if dotnetHasNLog}}
    <PackageReference Include="NLog.Web.AspNetCore" Version="6.0.0" />
{{/if}}
{{#if dotnetHasOpenTelemetry}}
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.14.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.14.0" />
{{/if}}
{{#if dotnetHasRedis}}
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.0" />
{{/if}}
{{#if dotnetHasHangfire}}
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.22" />
    <PackageReference Include="Hangfire.InMemory" Version="1.0.0" />
{{/if}}
{{#if dotnetHasQuartz}}
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.15.0" />
{{/if}}
{{#if (includes dotnetLibraries "automapper")}}
    <PackageReference Include="AutoMapper" Version="16.2.0" />
{{/if}}
{{#if (includes dotnetLibraries "mediatr")}}
    <PackageReference Include="MediatR" Version="14.2.0" />
{{/if}}
{{#if (includes dotnetLibraries "fastendpoints")}}
    <PackageReference Include="FastEndpoints" Version="8.2.0" />
{{/if}}
{{#if (includes dotnetLibraries "api-versioning")}}
    <PackageReference Include="Asp.Versioning.Http" Version="10.0.0" />
{{/if}}
{{#if (includes dotnetLibraries "scalar")}}
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.13" />
{{/if}}
{{#if (includes dotnetLibraries "polly")}}
    <PackageReference Include="Polly.Extensions" Version="8.7.0" />
{{/if}}
{{#if (includes dotnetLibraries "masstransit")}}
    <PackageReference Include="MassTransit" Version="9.1.2" />
{{/if}}
{{#if (includes dotnetLibraries "rebus")}}
    <PackageReference Include="Rebus.ServiceProvider" Version="10.7.2" />
{{/if}}
{{#if (includes dotnetLibraries "coravel")}}
    <PackageReference Include="Coravel" Version="6.0.2" />
{{/if}}
{{#if (includes dotnetLibraries "magic-onion")}}
    <PackageReference Include="MagicOnion.Server" Version="7.10.2" />
{{/if}}
{{#if (includes dotnetLibraries "prometheus-net")}}
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
{{/if}}
{{#if (includes dotnetLibraries "seq")}}
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.1.0" />
{{/if}}
{{#if (includes dotnetLibraries "application-insights")}}
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.1.2" />
{{/if}}
{{#if (includes dotnetLibraries "sentry")}}
    <PackageReference Include="Sentry.AspNetCore" Version="6.7.0" />
{{/if}}
{{#if (includes dotnetLibraries "mongodb-driver")}}
    <PackageReference Include="MongoDB.Driver" Version="3.10.0" />
{{/if}}
{{#if (includes dotnetLibraries "nhibernate")}}
    <PackageReference Include="NHibernate" Version="5.7.0" />
{{/if}}
{{#if (includes dotnetLibraries "mapster")}}
    <PackageReference Include="Mapster.DependencyInjection" Version="10.0.11" />
{{/if}}
{{#if (includes dotnetLibraries "scrutor")}}
    <PackageReference Include="Scrutor" Version="7.0.0" />
{{/if}}
{{#if (includes dotnetLibraries "refit")}}
    <PackageReference Include="Refit.HttpClientFactory" Version="13.1.0" />
{{/if}}
{{#if (includes dotnetLibraries "fluent-email")}}
    <PackageReference Include="FluentEmail.Core" Version="3.0.2" />
{{/if}}
  </ItemGroup>
</Project>
