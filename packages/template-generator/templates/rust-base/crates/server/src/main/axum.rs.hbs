#[derive(Serialize)]
struct HealthResponse {
    status: &'static str,
    message: &'static str,
{{#if (or (eq rustOrm "sea-orm") (eq rustOrm "sqlx") (eq rustOrm "diesel"))}}
    database: &'static str,
{{/if}}
}

{{#if (eq rustOrm "sea-orm")}}
#[derive(Clone)]
pub struct AppState {
    pub db: Arc<DatabaseConnection>,
}

async fn health(
    axum::extract::State(state): axum::extract::State<AppState>,
) -> Json<HealthResponse> {
    let db_status = if state.db.ping().await.is_ok() {
        "connected"
    } else {
        "disconnected"
    };
    Json(HealthResponse {
        status: "ok",
        message: "Server is running",
        database: db_status,
    })
}
{{else if (eq rustOrm "sqlx")}}
#[derive(Clone)]
pub struct AppState {
    pub db: PgPool,
}

async fn health(
    axum::extract::State(state): axum::extract::State<AppState>,
) -> Json<HealthResponse> {
    let db_status = if state.db.acquire().await.is_ok() {
        "connected"
    } else {
        "disconnected"
    };
    Json(HealthResponse {
        status: "ok",
        message: "Server is running",
        database: db_status,
    })
}
{{else if (eq rustOrm "diesel")}}
#[derive(Clone)]
pub struct AppState {
    pub pool: Pool<AsyncPgConnection>,
}

async fn health(
    axum::extract::State(state): axum::extract::State<AppState>,
) -> Json<HealthResponse> {
    let db_status = match state.pool.get().await {
        Ok(_) => "connected",
        Err(_) => "disconnected",
    };
    Json(HealthResponse {
        status: "ok",
        message: "Server is running",
        database: db_status,
    })
}
{{else}}
async fn health() -> Json<HealthResponse> {
    Json(HealthResponse {
        status: "ok",
        message: "Server is running",
    })
}
{{/if}}

{{#if (eq rustApi "async-graphql")}}
/// GraphiQL IDE handler
async fn graphiql() -> impl IntoResponse {
    Html(
        GraphiQLSource::build()
            .endpoint("/graphql")
            .finish(),
    )
}

{{/if}}
/// CORS pinned to `CORS_ORIGIN` when set, permissive otherwise.
fn cors_layer() -> CorsLayer {
    match std::env::var("CORS_ORIGIN") {
        Ok(origin) if !origin.is_empty() => CorsLayer::new()
            .allow_origin(origin.parse::<axum::http::HeaderValue>().expect("invalid CORS_ORIGIN"))
            .allow_methods(tower_http::cors::Any)
            .allow_headers(tower_http::cors::Any),
        _ => CorsLayer::permissive(),
    }
}

#[tokio::main]
async fn main() -> {{#if (eq rustErrorHandling "anyhow-thiserror")}}anyhow::Result<()>{{else if (eq rustErrorHandling "eyre")}}eyre::Result<()>{{else}}Result<(), Box<dyn std::error::Error>>{{/if}} {
    // Load environment variables
    dotenvy::dotenv().ok();
{{#if (eq rustApi "jsonrpsee")}}

    // Start JSON-RPC on a dedicated port alongside the HTTP server
    let rpc_host = std::env::var("JSONRPC_HOST")
        .or_else(|_| std::env::var("HOST"))
        .unwrap_or_else(|_| "127.0.0.1".to_string());
    let rpc_port = std::env::var("JSONRPC_PORT").unwrap_or_else(|_| "9944".to_string());
    let rpc_address = format!("{rpc_host}:{rpc_port}").parse()?;
    let _rpc_server = rpc::start(rpc_address).await.map_err(|error| std::io::Error::other(error.to_string()))?;
{{/if}}
{{#if (eq rustObservability "metrics")}}

    // Install the Prometheus metrics recorder and HTTP exporter
    otel::install_metrics().map_err(|error| std::io::Error::other(error.to_string()))?;
{{/if}}
{{#if (or (eq rustOrm "mongodb") (eq rustOrm "rusqlite") (eq rustOrm "tokio-postgres"))}}

    // Connect the selected database driver at startup
    let _database = database::connect().await.map_err(|error| std::io::Error::other(error.to_string()))?;
{{/if}}
{{#if (eq observability "sentry")}}
    let _sentry_guard = observability::init_sentry();
{{/if}}
{{#if (eq rustErrorHandling "eyre")}}

    // Install color-eyre error handler
    color_eyre::install()?;
{{/if}}

{{#if (eq rustLogging "tracing")}}
    // Initialize tracing
    tracing_subscriber::registry()
        .with(
            tracing_subscriber::EnvFilter::try_from_default_env()
                .unwrap_or_else(|_| "debug".into()),
        )
        .with(tracing_subscriber::fmt::layer())
        .init();
{{else if (eq rustLogging "env-logger")}}
    // Initialize logging
    env_logger::init();
{{/if}}

{{#if (eq rustCaching "moka")}}
    // Initialize in-memory cache
    let _cache = cache::create_cache::<String>();
    {{#rustLog "info"}}"Moka in-memory cache initialized"{{/rustLog}}
{{/if}}
{{#if (eq rustCaching "redis")}}
    // Initialize Redis client
    let _redis_client = cache::create_redis_client()?;
    {{#rustLog "info"}}"Redis client initialized"{{/rustLog}}
{{/if}}
{{#if (eq caching "upstash-redis")}}
    // Initialize Upstash Redis client helper
    let _upstash_client = upstash_cache::create_client()?;
    {{#rustLog "info"}}"Upstash Redis client initialized"{{/rustLog}}
{{/if}}
{{#if (eq search "meilisearch")}}
    // Initialize Meilisearch client helper
    let _meilisearch_client = meilisearch::create_client()?;
    {{#rustLog "info"}}"Meilisearch client initialized"{{/rustLog}}
{{/if}}

{{#if (eq rustAuth "oauth2")}}
    // Initialize OAuth2 client
    let oauth2_client = auth::create_oauth2_client();
    let (_authorization_url, _csrf_token) = auth::authorize_url(&oauth2_client);
    {{#rustLog "info"}}"OAuth2 client initialized"{{/rustLog}}
{{/if}}

{{#if (eq rustOrm "sea-orm")}}
    // Initialize database connection
    let database_url = std::env::var("DATABASE_URL").expect("DATABASE_URL must be set");

    {{#rustLog "info"}}"Connecting to database..."{{/rustLog}}
    let db = Database::connect(&database_url).await?;
    {{#rustLog "info"}}"Database connected successfully"{{/rustLog}}

    let state = AppState { db: Arc::new(db) };

{{#if (eq rustApi "async-graphql")}}
    // Build GraphQL schema with database connection
    let schema = graphql::build_schema(state.db.clone());

    // Build router with GraphQL and state
    let app = Router::new()
        .route("/health", get(health))
        .route_service("/graphql", GraphQL::new(schema))
        .route("/graphiql", get(graphiql))
        .layer(cors_layer())
        .with_state(state);

    {{#rustLog "info"}}"GraphQL endpoint: /graphql"{{/rustLog}}
    {{#rustLog "info"}}"GraphiQL IDE: /graphiql"{{/rustLog}}
{{else}}
    // Build router with state
    let app = Router::new()
        .route("/health", get(health))
        .layer(cors_layer())
        .with_state(state);
{{/if}}
{{else if (eq rustOrm "sqlx")}}
    // Initialize database connection pool
    let database_url = std::env::var("DATABASE_URL").expect("DATABASE_URL must be set");

    {{#rustLog "info"}}"Connecting to database..."{{/rustLog}}
    let pool = PgPoolOptions::new()
        .max_connections(5)
        .connect(&database_url)
        .await?;
    {{#rustLog "info"}}"Database connected successfully"{{/rustLog}}

    let state = AppState { db: pool.clone() };

{{#if (eq rustApi "async-graphql")}}
    // Build GraphQL schema with database pool
    let schema = graphql::build_schema(pool);

    // Build router with GraphQL and state
    let app = Router::new()
        .route("/health", get(health))
        .route_service("/graphql", GraphQL::new(schema))
        .route("/graphiql", get(graphiql))
        .layer(cors_layer())
        .with_state(state);

    {{#rustLog "info"}}"GraphQL endpoint: /graphql"{{/rustLog}}
    {{#rustLog "info"}}"GraphiQL IDE: /graphiql"{{/rustLog}}
{{else}}
    // Build router with state
    let app = Router::new()
        .route("/health", get(health))
        .layer(cors_layer())
        .with_state(state);
{{/if}}
{{else if (eq rustOrm "diesel")}}
    // Initialize database connection pool
    let database_url = std::env::var("DATABASE_URL").expect("DATABASE_URL must be set");

    {{#rustLog "info"}}"Connecting to database..."{{/rustLog}}
    let manager = AsyncDieselConnectionManager::<AsyncPgConnection>::new(&database_url);
    let pool = Pool::builder(manager).build()?;
    {{#rustLog "info"}}"Database pool created successfully"{{/rustLog}}

    let state = AppState { pool: pool.clone() };

{{#if (eq rustApi "async-graphql")}}
    // Build GraphQL schema with database pool
    let schema = graphql::build_schema(pool);

    // Build router with GraphQL and state
    let app = Router::new()
        .route("/health", get(health))
        .route_service("/graphql", GraphQL::new(schema))
        .route("/graphiql", get(graphiql))
        .layer(cors_layer())
        .with_state(state);

    {{#rustLog "info"}}"GraphQL endpoint: /graphql"{{/rustLog}}
    {{#rustLog "info"}}"GraphiQL IDE: /graphiql"{{/rustLog}}
{{else}}
    // Build router with state
    let app = Router::new()
        .route("/health", get(health))
        .layer(cors_layer())
        .with_state(state);
{{/if}}
{{else}}
{{#if (eq rustApi "async-graphql")}}
    // Build GraphQL schema
    let schema = graphql::build_schema();

    // Build router with GraphQL
    let app = Router::new()
        .route("/health", get(health))
        .route_service("/graphql", GraphQL::new(schema))
        .route("/graphiql", get(graphiql))
        .layer(cors_layer());

    {{#rustLog "info"}}"GraphQL endpoint: /graphql"{{/rustLog}}
    {{#rustLog "info"}}"GraphiQL IDE: /graphiql"{{/rustLog}}
{{else}}
    // Build router
    let app = Router::new()
        .route("/health", get(health))
        .layer(cors_layer());
{{/if}}
{{/if}}

{{#if (eq rustAuth "tower-sessions")}}
    // Attach cookie-backed session management to every Axum route.
    let app = app.layer(auth::session_layer());
{{/if}}

    // Get host and port from environment
    let host = std::env::var("HOST").unwrap_or_else(|_| "127.0.0.1".to_string());
    let port = std::env::var("PORT").unwrap_or_else(|_| "3000".to_string());
    let addr = format!("{}:{}", host, port);

    {{#rustLog "info"}}"Starting HTTP server at http://{}", addr{{/rustLog}}

{{#if (eq rustApi "tonic")}}
    // Start gRPC server on a separate port
    let grpc_port = std::env::var("GRPC_PORT").unwrap_or_else(|_| "50051".to_string());
    let grpc_addr = format!("{}:{}", host, grpc_port).parse()?;

    {{#rustLog "info"}}"Starting gRPC server at {}", grpc_addr{{/rustLog}}

    let grpc_server = tonic::transport::Server::builder()
        .add_service(grpc::create_grpc_server())
        .serve(grpc_addr);

    // Start HTTP server
    let listener = tokio::net::TcpListener::bind(&addr).await?;
    let http_server = axum::serve(listener, app);

    // Run both servers concurrently
    tokio::select! {
        result = http_server => {
            if let Err(e) = result {
                {{#rustLog "error"}}"HTTP server error: {}", e{{/rustLog}}
            }
        }
        result = grpc_server => {
            if let Err(e) = result {
                {{#rustLog "error"}}"gRPC server error: {}", e{{/rustLog}}
            }
        }
    }
{{else}}
    // Start server
    let listener = tokio::net::TcpListener::bind(&addr).await?;
    axum::serve(listener, app).await?;
{{/if}}

    Ok(())
}
