{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**", ".output/**", ".vercel/output/**", ".nitro/**"],
      "env": ["BTS_TELEMETRY", "BFS_TELEMETRY_INGEST_URL", "VITE_BFS_TELEMETRY_ENABLED"],
      "passThroughEnv": ["BTS_TELEMETRY_DISABLED"]
    },
    "lint": {
      "dependsOn": ["^build", "^lint"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "cache": false
    },
    "web#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "cache": false
    },
    "test:integration": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "cache": false,
      "persistent": true
    }
  }
}
