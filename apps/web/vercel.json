{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && bun install",
  "buildCommand": "bun run build",
  "outputDirectory": ".vercel/output",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "better-fullstack-web.vercel.app"
        }
      ],
      "destination": "https://better-fullstack.dev/:path*",
      "permanent": true
    },
    {
      "source": "/docs/recipes/default-typescript-web",
      "destination": "/guides/typescript/create-tanstack-start-project",
      "permanent": true
    },
    {
      "source": "/docs/recipes/nextjs-self-backend",
      "destination": "/guides/typescript/nextjs-drizzle-better-auth",
      "permanent": true
    },
    {
      "source": "/docs/recipes/python-api",
      "destination": "/guides/python/fastapi-postgres-sqlalchemy",
      "permanent": true
    },
    {
      "source": "/docs/recipes/dotnet-service",
      "destination": "/guides/dotnet/aspnet-core-efcore",
      "permanent": true
    },
    {
      "source": "/docs/recipes/multi-ecosystem-product",
      "destination": "/docs/ecosystems/multi-ecosystem",
      "permanent": true
    },
    {
      "source": "/docs/recipes/browser-zip-workflow",
      "destination": "/docs/web-builder",
      "permanent": true
    },
    {
      "source": "/docs/recipes",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/docs/recipes/:path*",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/docs/sections/deployment",
      "destination": "/docs/stack-guides/deployment",
      "permanent": true
    },
    {
      "source": "/docs/sections/frontend-and-apps",
      "destination": "/docs/stack-guides/frontend-frameworks",
      "permanent": true
    },
    {
      "source": "/docs/sections/backend-and-api",
      "destination": "/docs/stack-guides/backend-frameworks",
      "permanent": true
    },
    {
      "source": "/docs/sections/data-and-storage",
      "destination": "/docs/stack-guides/database-orm-pairing",
      "permanent": true
    },
    {
      "source": "/docs/sections/auth-and-payments",
      "destination": "/docs/stack-guides/auth-providers",
      "permanent": true
    },
    {
      "source": "/docs/sections",
      "destination": "/docs/reference/options",
      "permanent": true
    },
    {
      "source": "/docs/sections/:path*",
      "destination": "/docs/reference/options",
      "permanent": true
    }
  ],
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=6144"
    }
  },
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in main|ibrahim/*) exit 1;; esac; if [ -n \"$VERCEL_GIT_PULL_REQUEST_ID\" ] && [ \"$VERCEL_GIT_COMMIT_AUTHOR_LOGIN\" = \"Marve10s\" ]; then exit 1; else exit 0; fi"
}
