{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["bun"],
    "paths": {
      "@/*": ["./src/*"],
      "@scripts/*": ["./scripts/*"]
    }
  },
  "include": ["src", "scripts", "remotion.config.ts"]
}
