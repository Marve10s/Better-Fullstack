{
  "name": "better-fullstack",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:cli": "turbo run dev --filter=create-better-fullstack",
    "cli": "cd apps/cli && node dist/cli.js",
    "dev:web": "turbo run dev --filter=web",
    "build:web": "turbo run build --filter=web --only",
    "build:docs": "turbo run build --filter=docs --only",
    "build:cli": "turbo run build --filter=create-better-fullstack",
    "build:core": "bun run --cwd packages/types build && bun run --cwd packages/project-lifecycle build && bun run --cwd packages/template-generator build && bun run --cwd apps/cli build",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:cli": "turbo test --filter=create-better-fullstack",
    "test:web": "turbo test --filter=web",
    "test:lifecycle": "bun test apps/cli/test/lifecycle/lifecycle-contract.test.ts apps/cli/test/lifecycle/project-transaction.test.ts apps/cli/test/lifecycle/scaffold-upgrade.test.ts apps/cli/test/lifecycle/stack-update.test.ts apps/cli/test/generation/gen-resource.test.ts apps/cli/test/generation/recipe-managed-region.test.ts apps/cli/test/generation/recipe-registry.test.ts apps/cli/test/generation/registry.test.ts apps/cli/test/mcp/mcp-project-lifecycle.test.ts apps/cli/test/mcp/mcp-protocol.test.ts apps/web/test/project/browser-cli-lifecycle.test.ts apps/web/test/project/project-download.test.ts apps/web/test/telemetry/telemetry-dashboard.test.ts packages/template-generator/test/processors/ai-docs-generator.test.ts",
    "test:mutation-contracts": "bun test scripts/validation/mutation-contract-audit.test.ts apps/cli/test/lifecycle/lifecycle-contract.test.ts apps/cli/test/generation/gen-resource.test.ts apps/cli/test/generation/recipe-managed-region.test.ts apps/cli/test/generation/recipe-registry.test.ts apps/cli/test/generation/registry.test.ts && bun run scripts/validation/mutation-contract-audit.ts",
    "test:release": "bun run build:core && bun run test:agent-docs && bun run test:plugin-bundle && bun run test:workflow-security && bun run test:public-evidence && bun run test:capability-evidence && bun run test:recommendations && bun run test:update-qualification && bun run test:update-action && bun test scripts/validation/verified-combinations-evidence.test.ts scripts/validation/build-verified-combinations.test.ts apps/web/test/stack/verified-combinations-badge.test.ts && bun run test:operational-trust && bun run test:mutation-contracts && bun run test:lifecycle && bun test apps/cli/test/support/template-snapshots.test.ts && bun run test:ai-examples && bun test apps/cli/test/recommendations/cli-builder-sync.test.ts && bun test apps/cli/test/generation/dependency-version-channel.test.ts && bun test apps/cli/test/generation/docs-scaffold-commands.test.ts apps/cli/test/generation/generated-command-contract.test.ts apps/cli/test/features/provider-env-docs.test.ts && bun test apps/web/test/content/docs-content-contract.test.ts apps/web/test/builder/preview-config.test.ts apps/web/test/stack/stack-state-contract.test.ts apps/web/test/stack/stack-command-parity.test.ts && bun test apps/cli/test/generation/generate-reproducible-command.test.ts && bun test apps/cli/test/lifecycle/add-history-commands.test.ts && bun run --cwd apps/web validate:tech-links",
    "test:release:record": "bun run scripts/release/record-release-guard.ts",
    "test:ai-examples": "cd apps/cli && bun test test/generation/examples.test.ts",
    "test:plugin-bundle": "bun run scripts/validation/validate-plugin-bundle.ts",
    "test:agent-docs": "bun run scripts/validation/validate-agent-docs.ts",
    "test:workflow-security": "bun run --cwd packages/types build && bun run --cwd packages/template-generator build && bun test scripts/dependency-workflows.test.ts scripts/validation/validate-preview-workflows.test.ts scripts/release/validate-release-workflow.test.ts scripts/release/release-state.test.ts scripts/release/release-fixture.test.ts scripts/release/cross-version-upgrade.test.ts scripts/release/qualify-previous-release.test.ts scripts/release/release-receipt.test.ts && bun run scripts/validation/validate-preview-workflows.ts && bun run scripts/release/validate-release-workflow.ts",
    "test:public-evidence": "bun test scripts/evidence/validate-public-evidence-claims.test.ts && bun run scripts/evidence/validate-public-evidence-claims.ts",
    "test:capability-evidence": "bun test packages/types/test/capabilities/capability-inventory.test.ts testing/generated-project-proof.test.ts scripts/evidence/capability-evidence-audit.test.ts scripts/evidence/capability-maintenance-report.test.ts apps/cli/test/telemetry/evidence-levels.test.ts apps/cli/test/mcp/mcp-protocol.test.ts && bun run scripts/evidence/capability-evidence-audit.ts --markdown",
    "test:recommendations": "bun test scripts/evidence/recommendation-evaluation.test.ts packages/types/test/stack/starter-tracks.test.ts apps/cli/test/recommendations/starter-tracks.test.ts apps/cli/test/recommendations/recommend-stack.test.ts apps/web/test/builder/recommend-preset.test.ts && bun run scripts/evidence/recommendation-evaluation.ts",
    "test:recipe-runtime": "bun run testing/recipe-generation-proof.ts",
    "test:update-qualification": "bun test scripts/release/validate-update-qualification.test.ts && bun run scripts/release/validate-update-qualification.ts",
    "test:update-action": "bun test scripts/release/update-check-action.test.ts && bun run scripts/release/validate-update-action.ts",
    "test:operational-trust": "bun test apps/analytics/test/retirement.test.ts packages/backend/test/analytics-backfill-contract.test.ts scripts/validation/planning-registry.test.ts",
    "test:external-upgrades": "bun run scripts/validation/validate-external-upgrades.ts",
    "test:published-package": "bun run scripts/release/published-package-smoke.ts",
    "check": "oxfmt . && oxlint .",
    "fix:em-dashes": "bun run scripts/replace-em-dashes.ts",
    "check:em-dashes": "bun run scripts/replace-em-dashes.ts --check",
    "check:imports": "bun run scripts/architecture/import-aliases.ts --check",
    "check:layout": "bun run scripts/architecture/module-layout.ts --check && bun run scripts/architecture/test-layout.ts --check",
    "fix:imports": "bun run scripts/architecture/import-aliases.ts --write",
    "prepare": "bun run scripts/maintenance/install-hooks.ts",
    "release": "bun run scripts/release/release.ts",
    "bump": "bun run scripts/release/bump-version.ts",
    "canary": "bun run scripts/release/canary-release.ts",
    "cleanup-previews": "bun run scripts/maintenance/cleanup-previews.ts",
    "deploy:convex": "turbo run --filter=@better-fullstack/backend deploy",
    "deploy:web": "bun run --filter=web deploy",
    "generate": "bun run --filter=web generate-schema",
    "deploy": "bun run deploy:web",
    "update-deps": "bun run --filter=@better-fullstack/template-generator check-deps",
    "update-deps:fix": "bun run --filter=@better-fullstack/template-generator check-deps:fix",
    "sync-versions": "bun run --filter=@better-fullstack/template-generator sync-versions",
    "upstream-gap-report": "bun run scripts/maintenance/upstream-gap-report.ts --markdown",
    "build:verified-combinations": "bun run scripts/validation/build-verified-combinations.ts",
    "test:smoke": "bun run testing/smoke-test.ts",
    "test:smoke:strict": "bun run testing/smoke-test.ts --preset all --dev-check --strict",
    "test:smoke:pr-core": "bun run testing/smoke-test.ts --preset pr-core --dev-check --strict --output testing/.smoke-output/core",
    "test:smoke:pr-broad": "bun run testing/smoke-test.ts --preset pr-broad --dev-check --strict --output testing/.smoke-output/broad",
    "test:smoke:benchmark-deep": "bun run testing/smoke-test.ts --preset ai-search-workbench --dev-check --strict --route-check --quality-gate --doctor-check --output testing/.smoke-output/benchmark-deep",
    "test:e2e": "turbo test:e2e",
    "test:e2e:cli": "E2E=1 bun test ./apps/cli/test/e2e/e2e.e2e.ts --timeout 600000",
    "test:e2e:package-managers": "bun test apps/cli/test/e2e/default-package-manager-matrix.test.ts --timeout 900000",
    "test:e2e:web": "cd apps/web && bunx playwright test",
    "test:integration": "turbo test:integration"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@better-fullstack/project-lifecycle": "workspace:*",
    "@better-fullstack/template-generator": "workspace:*",
    "@better-fullstack/types": "workspace:*",
    "@effect/platform": "^0.96.2",
    "@effect/platform-bun": "^0.90.0",
    "@types/bun": "^1.4.0",
    "@types/three": "^0.183.1",
    "changelogithub": "^14.0.0",
    "create-better-fullstack": "workspace:*",
    "effect": "^3.22.1",
    "lefthook": "^2.1.12",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.19.0",
    "oxlint": "^1.80.0",
    "playwright": "1.62.1",
    "turbo": "^2.10.12",
    "typescript": "5.9.3"
  },
  "overrides": {
    "changelogen": "0.6.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.12"
}
