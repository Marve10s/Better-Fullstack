{
  "name": "better-fullstack",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:cli": "turbo run dev --filter=create-better-fullstack",
    "cli": "cd apps/cli && node dist/cli.js",
    "dev:web": "turbo run dev --filter=web",
    "build:web": "turbo run build --filter=web --only",
    "build:docs": "turbo run build --filter=docs --only",
    "build:cli": "turbo run build --filter=create-better-fullstack",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:cli": "turbo test --filter=create-better-fullstack",
    "test:web": "turbo test --filter=web",
    "test:lifecycle": "bun test apps/cli/test/project-transaction.test.ts apps/cli/test/scaffold-upgrade.test.ts apps/cli/test/stack-update.test.ts apps/cli/test/mcp-project-lifecycle.test.ts apps/web/test/browser-cli-lifecycle.test.ts apps/web/test/project-download.test.ts apps/web/test/telemetry-dashboard.test.ts",
    "test:release": "bun run test:agent-docs && bun run test:plugin-bundle && bun run test:workflow-security && bun test scripts/verified-combinations-evidence.test.ts scripts/build-verified-combinations.test.ts apps/web/test/verified-combinations-badge.test.ts && bun run test:operational-trust && bun run --cwd packages/types build && bun run --cwd packages/template-generator build && bun run test:lifecycle && bun test apps/cli/test/template-snapshots.test.ts && bun run test:ai-examples && bun test apps/cli/test/cli-builder-sync.test.ts && bun test apps/cli/test/dependency-version-channel.test.ts && bun test apps/cli/test/docs-scaffold-commands.test.ts apps/cli/test/generated-command-contract.test.ts apps/cli/test/provider-env-docs.test.ts && bun test apps/web/test/docs-content-contract.test.ts apps/web/test/preview-config.test.ts apps/web/test/stack-state-contract.test.ts apps/web/test/stack-command-parity.test.ts && bun test apps/cli/test/generate-reproducible-command.test.ts && bun test apps/cli/test/add-history-commands.test.ts && bun run --cwd apps/web validate:tech-links",
    "test:release:record": "bun run scripts/record-release-guard.ts",
    "test:ai-examples": "cd apps/cli && bun test test/examples.test.ts",
    "test:plugin-bundle": "bun run scripts/validate-plugin-bundle.ts",
    "test:agent-docs": "bun run scripts/validate-agent-docs.ts",
    "test:workflow-security": "bun test scripts/dependency-workflows.test.ts scripts/validate-preview-workflows.test.ts && bun run scripts/validate-preview-workflows.ts",
    "test:operational-trust": "bun test apps/analytics/test/retirement.test.ts packages/backend/test/analytics-backfill-contract.test.ts scripts/planning-registry.test.ts scripts/record-scaffbench-canonical.test.ts apps/cli/test/scaffbench-solvability-contract.test.ts",
    "test:external-upgrades": "bun run scripts/validate-external-upgrades.ts",
    "test:published-package": "bun run scripts/published-package-smoke.ts",
    "check": "oxfmt . && oxlint .",
    "prepare": "bun run scripts/install-hooks.ts",
    "release": "bun run scripts/release.ts",
    "bump": "bun run scripts/bump-version.ts",
    "canary": "bun run scripts/canary-release.ts",
    "cleanup-previews": "bun run scripts/cleanup-previews.ts",
    "deploy:convex": "turbo run --filter=@better-fullstack/backend deploy",
    "deploy:web": "bun run --filter=web deploy",
    "generate": "bun run --filter=web generate-schema",
    "deploy": "bun run deploy:web",
    "update-deps": "bun run --filter=@better-fullstack/template-generator check-deps",
    "update-deps:fix": "bun run --filter=@better-fullstack/template-generator check-deps:fix",
    "sync-versions": "bun run --filter=@better-fullstack/template-generator sync-versions",
    "upstream-gap-report": "bun run scripts/upstream-gap-report.ts --markdown",
    "scaffbench:2": "bun run scripts/scaffbench-v2.ts --specs core",
    "scaffbench:2:generate": "bun run scripts/scaffbench-v2.ts --specs core --generate-only",
    "scaffbench:2:validate": "bun run scripts/scaffbench-v2.ts --specs core --validate-existing",
    "scaffbench:2:quality": "bun run scripts/scaffbench-v2.ts --specs core --quality-gate --doctor-check",
    "scaffbench:2:matrix": "bun run scripts/scaffbench-v2.ts --write-matrix-only --out-dir testing/.tmp-scaffbench-2",
    "scaffbench:2:canonical": "bun run scripts/record-scaffbench-canonical.ts",
    "scaffbench:solvability": "bun test apps/cli/test/e2e/scaffbench-solvability.test.ts --timeout 1200000",
    "build:benchmark-data": "bun run scripts/build-benchmark-data.ts",
    "build:verified-combinations": "bun run scripts/build-verified-combinations.ts",
    "test:smoke": "bun run testing/smoke-test.ts",
    "test:smoke:strict": "bun run testing/smoke-test.ts --preset all --dev-check --strict",
    "test:smoke:pr-core": "bun run testing/smoke-test.ts --preset pr-core --dev-check --strict --output testing/.smoke-output/core",
    "test:smoke:pr-broad": "bun run testing/smoke-test.ts --preset pr-broad --dev-check --strict --output testing/.smoke-output/broad",
    "test:smoke:benchmark-deep": "bun run testing/smoke-test.ts --preset ai-search-workbench --dev-check --strict --route-check --quality-gate --doctor-check --output testing/.smoke-output/benchmark-deep",
    "test:e2e": "turbo test:e2e",
    "test:e2e:cli": "E2E=1 bun test ./apps/cli/test/e2e/e2e.e2e.ts --timeout 600000",
    "test:e2e:package-managers": "bun test apps/cli/test/e2e/default-package-manager-matrix.test.ts --timeout 900000",
    "test:e2e:web": "cd apps/web && bunx playwright test",
    "test:integration": "turbo test:integration"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@effect/platform": "^0.96.2",
    "@effect/platform-bun": "^0.90.0",
    "@types/bun": "^1.4.0",
    "@types/three": "^0.183.1",
    "changelogithub": "^14.0.0",
    "effect": "^3.22.1",
    "lefthook": "^2.1.10",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.19.0",
    "oxlint": "^1.79.0",
    "playwright": "1.62.1",
    "turbo": "^2.10.11",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.5"
}
